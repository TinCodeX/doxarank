# ==============================================================================
# DoxaRank Backend Environment Configuration
# ==============================================================================
# Duplicate this file to `backend/.env` and update the values for your environment.

# ------------------------------------------------------------------------------
# 1. Core Django Settings
# ------------------------------------------------------------------------------
# SECURITY WARNING: keep the secret key used in production secret!
SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-random-key
DEBUG=True
DOXARANK_ENV=development

# Database configuration: supports SQLite locally or PostgreSQL / Neon in staging & prod
# Example PostgreSQL: postgres://username:password@ep-cool-db.us-east-2.aws.neon.tech/doxarank?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# Comma-separated hostnames and IPs allowed to connect
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Comma-separated origins allowed for CORS and CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4321,http://127.0.0.1:4321
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4321,http://127.0.0.1:4321

# ------------------------------------------------------------------------------
# 2. Data Encryption Key (Fernet / AES-128-CBC)
# ------------------------------------------------------------------------------
# Used to encrypt sensitive integration tokens (Google OAuth, Clarity tokens) at rest in the database.
# Generate in python with: `from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())`
DOXARANK_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 3. Redis, Celery & Django Channels
# ------------------------------------------------------------------------------
# Redis connection string used for Celery task broker, Celery results, and WebSockets (Channels)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Set to True for local development without running a Celery worker daemon (tasks run in-process)
CELERY_TASK_ALWAYS_EAGER=False

# ------------------------------------------------------------------------------
# 4. Agentic AI & LLM Provider Configuration
# ------------------------------------------------------------------------------
# AI Provider selection: 'openai' (uses OpenAI API) or 'mock' (deterministic rule-based fallback)
AI_PROVIDER=openai

# OpenAI API Key (Required if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

# Synthetic simulation delay for mock AI provider (seconds, float)
MOCK_AI_RESPONSE_DELAY=0.0

# ------------------------------------------------------------------------------
# 5. External SEO & Keyword Intelligence (DataForSEO)
# ------------------------------------------------------------------------------
# DataForSEO API credentials for search volume, CPC, and competition density
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_API_URL=https://api.dataforseo.com/v3
KEYWORD_INTELLIGENCE_PROVIDER=unconfigured

# ------------------------------------------------------------------------------
# 6. Google Integrations (Search Console, GA4, GTM)
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Client credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback/

# ------------------------------------------------------------------------------
# 7. Microsoft Clarity Integration
# ------------------------------------------------------------------------------
# Microsoft Application Developer credentials for Clarity analytics
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/clarity/callback/
CLARITY_API_BASE_URL=https://www.clarity.ms/api/v1

# ------------------------------------------------------------------------------
# 8. Doxa Payments (Chapa / Telebirr Aggregator)
# ------------------------------------------------------------------------------
# Merchant credentials for local Ethiopian payments
DOXA_PAYMENTS_API_KEY=
DOXA_PAYMENTS_SECRET=
DOXA_PAYMENTS_BASE_URL=https://api.doxapayments.com/v1
DOXA_PAYMENTS_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 9. Technical Crawler & SERP Tracker Settings
# ------------------------------------------------------------------------------
CRAWLER_USER_AGENT=DoxaRankBot/1.0 (+https://doxarank.com/bot)
CRAWLER_REQUEST_TIMEOUT=15
CRAWLER_MAX_CONCURRENT_REQUESTS=5
SERP_REQUEST_DELAY=1.5
SERP_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 10. Email & Contact Notification Settings
# ------------------------------------------------------------------------------
# In development, console backend is used by default if EMAIL_HOST_USER is blank.
# For production SMTP (e.g. Gmail, SES, SendGrid, Mailgun):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=DoxaRank <noreply@doxarank.com>
CONTACT_NOTIFICATION_EMAIL=support@doxarank.com
