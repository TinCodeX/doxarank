# ==============================================================================
# DoxaRank Marketing Site Environment Configuration
# ==============================================================================
# Duplicate this file to `marketing/.env` and update the values for your environment.
# Note: Astro exposes variables prefixed with `PUBLIC_` to the browser client.

# URL of the authenticated Dashboard application (used in Login/Signup CTA redirects)
PUBLIC_DASHBOARD_URL=http://localhost:5173

# Optional: Public API URL for marketing lead forms or live site health checks
PUBLIC_API_URL=http://127.0.0.1:8000
