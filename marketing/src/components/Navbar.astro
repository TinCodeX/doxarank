---
const navItems = [
  { label: 'Features', href: '/features' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Blog', href: '/blog' },
  { label: 'Case Studies', href: '/case-studies' },
  { label: 'About', href: '/about' },
];
---

<header class="border-b border-gray-200 bg-white">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    
    <!-- Logo -->
    <a href="/" class="text-2xl font-bold">
      DoxaRank
    </a>

    <!-- Navigation -->
    <div class="hidden items-center gap-8 md:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-sm font-medium text-gray-600 transition hover:text-black"
        >
          {item.label}
        </a>
      ))}
    </div>

    <!-- Auth -->
    <div class="flex items-center gap-3">
      <a
        href="/login"
        class="hidden text-sm font-medium text-gray-600 hover:text-black sm:block"
      >
        Log in
      </a>

      <a
        href="/signup"
        class="rounded-lg bg-black px-4 py-2 text-sm font-medium text-white transition hover:bg-gray-800"
      >
        Get Started
      </a>
    </div>

  </nav>
</header>