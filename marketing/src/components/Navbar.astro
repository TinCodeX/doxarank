---
const navItems = [
  { label: 'Features', href: '/features' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'About', href: '/about' },
  { label: 'Case Studies', href: '/case-studies' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-purple-900/10 bg-white/95 backdrop-blur-md transition-all">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    
    <!-- Brand Logo with Official Doxa Asset -->
    <a href="/" class="group flex items-center gap-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#774DA9] rounded-lg">
      <img
        src="/doxa-logo.png"
        alt="DoxaRank Logo"
        class="h-9 w-9 object-contain rounded-lg shadow-xs transition group-hover:scale-105"
        width="36"
        height="36"
      />
      <div class="flex items-center gap-2">
        <span class="text-xl font-extrabold tracking-tight text-[#24143C]">
          Doxa<span class="text-[#774DA9]">Rank</span>
        </span>
        <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-bold text-emerald-700 border border-emerald-200/80">
          ET
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="Main Navigation">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class:list={[
              'rounded-lg px-3.5 py-2 text-sm font-medium transition-colors',
              isActive
                ? 'bg-[#ece4f6] text-[#774DA9] font-bold'
                : 'text-slate-600 hover:bg-[#faf7fd] hover:text-[#24143C]',
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Desktop Action Buttons -->
    <div class="hidden items-center gap-3 md:flex">
      <!-- Language Picker -->
      <select
        id="marketing-lang-select"
        aria-label="Select Language"
        class="rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-700 shadow-xs hover:border-[#774DA9] focus:outline-none focus:ring-1 focus:ring-[#774DA9] cursor-pointer"
      >
        <option value="en">English (EN)</option>
        <option value="am">አማርኛ (AM)</option>
        <option value="om">Afaan Oromoo (OM)</option>
      </select>

      <a
        href="/login"
        class="rounded-lg px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-[#faf7fd] hover:text-[#774DA9]"
      >
        Sign In
      </a>
      <a
        href="/signup"
        class="inline-flex items-center justify-center rounded-lg bg-[#774DA9] px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-[#673f97] hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#774DA9]"
      >
        Start Free
      </a>
    </div>

    <!-- Mobile Hamburger Toggle Button -->
    <div class="flex md:hidden">
      <button
        type="button"
        id="mobile-menu-btn"
        class="inline-flex items-center justify-center rounded-lg p-2 text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-[#774DA9]"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span class="sr-only">Open main menu</span>
        <!-- Hamburger Icon -->
        <svg id="hamburger-icon" class="h-6 w-6 block" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <!-- Close Icon -->
        <svg id="close-icon" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-5 shadow-xl">
    <div class="space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="block rounded-lg px-3 py-2 text-base font-medium text-slate-700 hover:bg-[#faf7fd] hover:text-[#774DA9]"
        >
          {item.label}
        </a>
      ))}
    </div>
    <div class="mt-4 border-t border-slate-100 pt-4 flex flex-col gap-2">
      <select
        id="mobile-lang-select"
        aria-label="Select Language"
        class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 shadow-xs hover:border-[#774DA9] focus:outline-none focus:ring-1 focus:ring-[#774DA9] cursor-pointer"
      >
        <option value="en">English (EN)</option>
        <option value="am">አማርኛ (AM)</option>
        <option value="om">Afaan Oromoo (OM)</option>
      </select>
      <a
        href="/login"
        class="block w-full text-center rounded-lg border border-slate-200 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50"
      >
        Sign In
      </a>
      <a
        href="/signup"
        class="block w-full text-center rounded-lg bg-[#774DA9] py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-[#673f97]"
      >
        Start Free
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const close = document.getElementById('close-icon');

  if (btn && menu && hamburger && close) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      hamburger.classList.toggle('hidden');
      hamburger.classList.toggle('block');
      close.classList.toggle('hidden');
      close.classList.toggle('block');
    });
  }

  // Language selection sync with localStorage
  const desktopLang = document.getElementById('marketing-lang-select') as HTMLSelectElement | null;
  const mobileLang = document.getElementById('mobile-lang-select') as HTMLSelectElement | null;
  const savedLang = localStorage.getItem('doxarank_app_language') || 'en';

  if (desktopLang) desktopLang.value = savedLang;
  if (mobileLang) mobileLang.value = savedLang;

  const onLangChange = (e: Event) => {
    const val = (e.target as HTMLSelectElement).value;
    localStorage.setItem('doxarank_app_language', val);
    if (desktopLang) desktopLang.value = val;
    if (mobileLang) mobileLang.value = val;
  };

  if (desktopLang) desktopLang.addEventListener('change', onLangChange);
  if (mobileLang) mobileLang.addEventListener('change', onLangChange);
</script>