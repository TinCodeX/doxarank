---
const navItems = [
  { key: 'nav.features', label: 'Features', href: '/features' },
  { key: 'nav.pricing', label: 'Pricing', href: '/pricing' },
  { key: 'nav.case_studies', label: 'Case Studies', href: '/case-studies' },
  { key: 'nav.blog', label: 'Blog', href: '/blog' },
  { key: 'nav.about', label: 'About', href: '/about' },
  { key: 'nav.contact', label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<!-- Floating Pill Header (Not a full-bleed rectangular bar) -->
<header class="sticky top-0 z-50 pt-3 sm:pt-4 pb-2 px-3 sm:px-6 transition-all duration-300">
  <div class="mx-auto max-w-6xl">
    
    <!-- Outer Pill Island Container -->
    <div class="glass-pill rounded-full px-3.5 sm:px-5 py-2 flex items-center justify-between transition-all duration-300 hover:shadow-md hover:border-purple-300/50">
      
      <!-- Left: Brand Logo & ET Badge -->
      <a href="/" class="group flex items-center gap-2.5 focus:outline-none rounded-full pr-1">
        <div class="relative flex items-center justify-center h-8 w-8 sm:h-9 sm:w-9 rounded-full bg-gradient-to-br from-purple-100 to-purple-200/60 p-0.5 shadow-xs transition group-hover:scale-105">
          <img
            src="/doxa-logo.png"
            alt="DoxaRank Logo"
            class="h-7 w-7 sm:h-8 sm:w-8 object-contain rounded-full"
            width="32"
            height="32"
          />
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-base sm:text-lg font-extrabold tracking-tight text-[#24143C]">
            Doxa<span class="text-[#774DA9]">Rank</span>
          </span>
          <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-[9px] sm:text-[10px] font-bold text-emerald-700 border border-emerald-200/80">
            ET
          </span>
        </div>
      </a>

      <!-- Center: Navigation Links in Pill Capsule (Desktop) -->
      <nav class="hidden md:flex items-center gap-0.5 lg:gap-1" aria-label="Main Navigation">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              data-i18n={item.key}
              class:list={[
                'rounded-full px-3 py-1.5 text-xs lg:text-sm font-medium transition-colors',
                isActive
                  ? 'bg-[#ece4f6] text-[#774DA9] font-bold shadow-2xs'
                  : 'text-slate-600 hover:bg-purple-50/70 hover:text-[#24143C]',
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Right: Action Buttons (Desktop) -->
      <div class="hidden items-center gap-2 lg:gap-2.5 md:flex">
        <!-- Language Picker Pill -->
        <div class="relative">
          <select
            id="marketing-lang-select"
            aria-label="Select Language"
            class="rounded-full border border-purple-200/60 bg-white/80 px-2.5 py-1 text-xs font-semibold text-slate-700 shadow-2xs hover:border-[#774DA9] focus:outline-none focus:ring-1 focus:ring-[#774DA9] cursor-pointer"
          >
            <option value="en">EN</option>
            <option value="am">አማ (AM)</option>
            <option value="om">OM</option>
          </select>
        </div>

        <!-- Sign In Pill Button -->
        <a
          href="/login"
          data-i18n="nav.sign_in"
          class="rounded-full px-3.5 py-1.5 text-xs lg:text-sm font-semibold text-slate-700 hover:text-[#774DA9] hover:bg-purple-50/60 transition"
        >
          Sign In
        </a>

        <!-- Primary CTA Pill Button -->
        <a
          href="/signup"
          data-i18n="nav.start_free"
          class="btn-pill-primary inline-flex items-center justify-center px-4 sm:px-5 py-1.5 sm:py-2 text-xs lg:text-sm font-semibold tracking-wide text-white transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[#774DA9]"
        >
          Start Free
        </a>
      </div>

      <!-- Mobile Right Controls (Language + Hamburger) -->
      <div class="flex items-center gap-2 md:hidden">
        <select
          id="mobile-lang-select"
          aria-label="Select Language"
          class="rounded-full border border-purple-200/60 bg-white/90 px-2 py-1 text-[11px] font-semibold text-slate-700 shadow-2xs focus:outline-none cursor-pointer"
        >
          <option value="en">EN</option>
          <option value="am">አማ</option>
          <option value="om">OM</option>
        </select>

        <button
          type="button"
          id="mobile-menu-btn"
          class="inline-flex items-center justify-center rounded-full p-1.5 text-slate-700 hover:bg-purple-50 focus:outline-none focus:ring-2 focus:ring-[#774DA9]"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="sr-only">Open main menu</span>
          <svg id="hamburger-icon" class="h-5 w-5 block" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <svg id="close-icon" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>

    <!-- Mobile Dropdown Menu Card (Floats as rounded card beneath the pill) -->
    <div id="mobile-menu" class="hidden md:hidden mt-2 glass-dropdown rounded-3xl p-4 shadow-2xl border border-purple-200/60 bg-white/95">
      <div class="space-y-1">
        {navItems.map((item) => (
          <a
            href={item.href}
            data-i18n={item.key}
            class="block rounded-xl px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-purple-50 hover:text-[#774DA9]"
          >
            {item.label}
          </a>
        ))}
      </div>

      <div class="mt-4 pt-3 border-t border-purple-100 flex flex-col gap-2">
        <a
          href="/login"
          data-i18n="nav.sign_in"
          class="btn-pill-secondary block w-full text-center py-2 text-xs font-semibold text-slate-700 hover:text-[#774DA9]"
        >
          Sign In
        </a>
        <a
          href="/signup"
          data-i18n="nav.start_free"
          class="btn-pill-primary block w-full text-center py-2 text-xs font-semibold text-white shadow-sm"
        >
          Start Free
        </a>
      </div>
    </div>

  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const close = document.getElementById('close-icon');

  if (btn && menu && hamburger && close) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      hamburger.classList.toggle('hidden');
      hamburger.classList.toggle('block');
      close.classList.toggle('hidden');
      close.classList.toggle('block');
    });
  }

  // Language selection sync with localStorage and global translation engine
  const desktopLang = document.getElementById('marketing-lang-select') as HTMLSelectElement | null;
  const mobileLang = document.getElementById('mobile-lang-select') as HTMLSelectElement | null;
  const savedLang = localStorage.getItem('doxarank_app_language') || 'en';

  if (desktopLang) desktopLang.value = savedLang;
  if (mobileLang) mobileLang.value = savedLang;

  const onLangChange = (e: Event) => {
    const val = (e.target as HTMLSelectElement).value;
    if ((window as any).doxaChangeLanguage) {
      (window as any).doxaChangeLanguage(val);
    } else {
      localStorage.setItem('doxarank_app_language', val);
      if (desktopLang) desktopLang.value = val;
      if (mobileLang) mobileLang.value = val;
    }
  };

  if (desktopLang) desktopLang.addEventListener('change', onLangChange);
  if (mobileLang) mobileLang.addEventListener('change', onLangChange);
</script>