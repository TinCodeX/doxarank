---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-white text-slate-600">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4 lg:grid-cols-5">
      
      <!-- Brand Column (spans 2 on lg) -->
      <div class="col-span-2">
        <a href="/" class="flex items-center gap-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-900 shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none">
              <rect x="4" y="14" width="3" height="6" rx="1" fill="#10b981" />
              <rect x="10.5" y="9" width="3" height="11" rx="1" fill="#38bdf8" />
              <rect x="17" y="4" width="3" height="16" rx="1" fill="#6366f1" />
              <path d="M4 11L10.5 6L17 2" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <span class="text-xl font-extrabold tracking-tight text-slate-900">
            Doxa<span class="text-indigo-600">Rank</span>
          </span>
          <span class="rounded bg-emerald-50 px-1.5 py-0.5 text-[10px] font-bold text-emerald-700 border border-emerald-200/60">
            🇪🇹 ET
          </span>
        </a>
        <p class="mt-4 max-w-sm text-sm text-slate-500 leading-relaxed">
          The Ethiopia-first SEO platform engineered for Google Ethiopia (google.com.et), Amharic search queries, .et domain technical auditing, and local business growth.
        </p>
        <div class="mt-6 flex items-center gap-2 text-xs font-semibold text-slate-500">
          <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
          Live SERP monitoring across Addis Ababa &amp; Ethiopia
        </div>
      </div>

      <!-- Product Links -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900">Product</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href="/features#rank-tracker" class="hover:text-indigo-600 transition">Rank Tracker (ET)</a></li>
          <li><a href="/features#crawler" class="hover:text-indigo-600 transition">Technical SEO Crawler</a></li>
          <li><a href="/features#keyword-intelligence" class="hover:text-indigo-600 transition">Keyword Intelligence &amp; CPC</a></li>
          <li><a href="/features#competitor-snapshots" class="hover:text-indigo-600 transition">Competitor Snapshots</a></li>
          <li><a href="/features#reports" class="hover:text-indigo-600 transition">White-Label Reports</a></li>
          <li><a href="/features#tools" class="hover:text-indigo-600 transition">Free SEO Tools</a></li>
        </ul>
      </div>

      <!-- Company Links -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900">Company</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href="/about" class="hover:text-indigo-600 transition">About DoxaRank</a></li>
          <li><a href="/pricing" class="hover:text-indigo-600 transition">Pricing Plans</a></li>
          <li><a href="/case-studies" class="hover:text-indigo-600 transition">Case Studies</a></li>
          <li><a href="/blog" class="hover:text-indigo-600 transition">Blog &amp; Research</a></li>
          <li><a href="/contact" class="hover:text-indigo-600 transition">Contact Us</a></li>
        </ul>
      </div>

      <!-- Integrations & Account -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900">Platform</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href="/features#integrations" class="hover:text-indigo-600 transition">Google Search Console</a></li>
          <li><a href="/features#integrations" class="hover:text-indigo-600 transition">Google Analytics 4</a></li>
          <li><a href="/features#integrations" class="hover:text-indigo-600 transition">Microsoft Clarity</a></li>
          <li><a href="/features#integrations" class="hover:text-indigo-600 transition">Google Tag Manager</a></li>
          <li><a href="/login" class="hover:text-indigo-600 font-semibold text-slate-800 transition">Sign In to Dashboard</a></li>
          <li><a href="/signup" class="hover:text-indigo-600 font-semibold text-indigo-600 transition">Create Free Account</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 border-t border-slate-200 pt-8 sm:flex sm:items-center sm:justify-between text-xs text-slate-500">
      <p>© {currentYear} DoxaRank. All rights reserved. Built for the Ethiopian digital ecosystem.</p>
      <div class="mt-4 sm:mt-0 flex gap-6">
        <span>Addis Ababa, Ethiopia</span>
        <span>•</span>
        <a href="/about" class="hover:underline">About</a>
        <span>•</span>
        <a href="/contact" class="hover:underline">Contact Support</a>
      </div>
    </div>
  </div>
</footer>