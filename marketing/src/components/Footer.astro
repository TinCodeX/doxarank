---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[#3b1d5f] bg-[#24143C] text-slate-300">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4 lg:grid-cols-5">
      
      <!-- Brand Column (spans 2 on lg) -->
      <div class="col-span-2">
        <a href="/" class="flex items-center gap-3">
          <img
            src="/doxa-logo.png"
            alt="DoxaRank Logo"
            class="h-8 w-8 object-contain rounded-md"
            width="32"
            height="32"
          />
          <span class="text-xl font-extrabold tracking-tight text-white">
            Doxa<span class="text-[#a372df]">Rank</span>
          </span>
          <span class="rounded-full bg-emerald-950 px-2 py-0.5 text-[10px] font-bold text-emerald-300 border border-emerald-800">
            ET
          </span>
        </a>
        <p class="mt-4 max-w-sm text-sm text-slate-400 leading-relaxed" data-i18n="footer.desc">
          The dedicated SEO intelligence platform for Google Ethiopia. Monitoring keywords in Amharic, Afaan Oromoo, and English.
        </p>
        <div class="mt-6 flex items-center gap-2 text-xs font-semibold text-emerald-400">
          <span class="inline-block h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Live SERP monitoring across Addis Ababa &amp; Ethiopia
        </div>
      </div>

      <!-- Product Links -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-100" data-i18n="footer.product">Product</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href="/features#rank-tracker" class="hover:text-[#a372df] transition">Rank Tracker (ET)</a></li>
          <li><a href="/features#crawler" class="hover:text-[#a372df] transition">Technical SEO Crawler</a></li>
          <li><a href="/features#keyword-intelligence" class="hover:text-[#a372df] transition">Keyword Intelligence &amp; CPC</a></li>
          <li><a href="/features#competitor-snapshots" class="hover:text-[#a372df] transition">Competitor Snapshots</a></li>
          <li><a href="/features#reports" class="hover:text-[#a372df] transition">White-Label Reports</a></li>
          <li><a href="/features#tools" class="hover:text-[#a372df] transition">Free SEO Tools</a></li>
        </ul>
      </div>

      <!-- Company Links -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-100" data-i18n="footer.company">Company</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href="/about" class="hover:text-[#a372df] transition">About DoxaRank</a></li>
          <li><a href="/pricing" class="hover:text-[#a372df] transition">Pricing Plans</a></li>
          <li><a href="/case-studies" class="hover:text-[#a372df] transition">Case Studies</a></li>
          <li><a href="/blog" class="hover:text-[#a372df] transition">Blog &amp; Research</a></li>
          <li><a href="/contact" class="hover:text-[#a372df] transition">Contact Us</a></li>
        </ul>
      </div>

      <!-- Integrations & Account -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-100" data-i18n="footer.platform">Platform</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href="/features#integrations" class="hover:text-[#a372df] transition">Google Search Console</a></li>
          <li><a href="/features#integrations" class="hover:text-[#a372df] transition">Google Analytics 4</a></li>
          <li><a href="/features#integrations" class="hover:text-[#a372df] transition">Microsoft Clarity</a></li>
          <li><a href="/features#integrations" class="hover:text-[#a372df] transition">Google Tag Manager</a></li>
          <li><a href="/login" class="hover:text-white font-semibold text-[#a372df] transition" data-i18n="nav.sign_in">Sign In</a></li>
          <li><a href="/signup" class="hover:text-white font-semibold text-emerald-400 transition" data-i18n="nav.start_free">Start Free</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 border-t border-[#3b1d5f] pt-8 sm:flex sm:items-center sm:justify-between text-xs text-slate-400">
      <p>© {currentYear} DoxaRank. <span data-i18n="footer.rights">All rights reserved. Built for the Ethiopian digital ecosystem.</span></p>
      <div class="mt-4 sm:mt-0 flex gap-6">
        <span>Addis Ababa, Ethiopia</span>
        <span>•</span>
        <a href="/about" class="hover:text-[#a372df]" data-i18n="footer.about">About</a>
        <span>•</span>
        <a href="/contact" class="hover:text-[#a372df]" data-i18n="footer.contact">Contact Support</a>
      </div>
    </div>
  </div>
</footer>