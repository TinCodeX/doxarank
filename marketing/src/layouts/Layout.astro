---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { marketingTranslations } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  hideNav?: boolean;
  hideFooter?: boolean;
}

const {
  title = 'DoxaRank — The Ethiopia-First SEO Platform',
  description = 'Track rankings on Google Ethiopia (google.com.et), analyze Amharic and Oromo keywords, audit technical SEO on .et domains, and benchmark competitors.',
  canonicalUrl = 'https://doxarank.com',
  ogImage = '/og-image.png',
  hideNav = false,
  hideFooter = false,
} = Astro.props;

// Factual Organization Schema (No fake ratings or fabricated stats)
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'DoxaRank',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: description,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'ETB',
  },
  author: {
    '@type': 'Organization',
    name: 'DoxaRank',
    url: 'https://doxarank.com',
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'ET',
      addressLocality: 'Addis Ababa',
    },
  },
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="DoxaRank" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/png" href="/doxa-logo.png" />
    <link rel="apple-touch-icon" href="/doxa-logo.png" />

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+Ethiopic:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>

  <body class="flex min-h-screen flex-col bg-[#faf9fc] text-[#1a1625] antialiased selection:bg-[#774DA9] selection:text-white">
    {!hideNav && <Navbar />}
    <main class="flex-grow">
      <slot />
    </main>
    {!hideFooter && <Footer />}

    <!-- Marketing Client-Side i18n Translation Engine -->
    <script is:inline define:vars={{ marketingTranslations }}>
      (function() {
        window.doxaTranslations = marketingTranslations;

        window.doxaChangeLanguage = function(locale) {
          const validLocale = (locale === 'am' || locale === 'om' || locale === 'en') ? locale : 'en';
          try {
            localStorage.setItem('doxarank_app_language', validLocale);
          } catch (e) {
            // Local storage error handling
          }
          document.documentElement.lang = validLocale;

          // Sync all language dropdown selectors
          document.querySelectorAll('#marketing-lang-select, #mobile-lang-select').forEach(function(sel) {
            if (sel && sel.value !== validLocale) {
              sel.value = validLocale;
            }
          });

          const dict = window.doxaTranslations[validLocale] || window.doxaTranslations['en'];
          const fallbackDict = window.doxaTranslations['en'] || {};

          // Translate text content
          document.querySelectorAll('[data-i18n]').forEach(function(el) {
            const key = el.getAttribute('data-i18n');
            if (!key) return;
            if (dict[key] !== undefined) {
              el.textContent = dict[key];
            } else if (fallbackDict[key] !== undefined) {
              console.warn('[i18n] Fallback to English for key: "' + key + '" in locale: "' + validLocale + '"');
              el.textContent = fallbackDict[key];
            } else {
              console.warn('[i18n] Missing translation key: "' + key + '" across all locales!');
            }
          });

          // Translate placeholders
          document.querySelectorAll('[data-i18n-placeholder]').forEach(function(el) {
            const key = el.getAttribute('data-i18n-placeholder');
            if (!key) return;
            const text = dict[key] || fallbackDict[key];
            if (text) el.setAttribute('placeholder', text);
          });

          // Translate aria-labels
          document.querySelectorAll('[data-i18n-aria-label]').forEach(function(el) {
            const key = el.getAttribute('data-i18n-aria-label');
            if (!key) return;
            const text = dict[key] || fallbackDict[key];
            if (text) el.setAttribute('aria-label', text);
          });

          // Dispatch event for any custom components listening
          window.dispatchEvent(new CustomEvent('doxa-language-changed', { detail: { locale: validLocale } }));
        };

        // Initialize on load
        function initI18n() {
          let currentLocale = 'en';
          try {
            currentLocale = localStorage.getItem('doxarank_app_language') || 'en';
          } catch (e) {}
          window.doxaChangeLanguage(currentLocale);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initI18n);
        } else {
          initI18n();
        }
      })();
    </script>
  </body>
</html>