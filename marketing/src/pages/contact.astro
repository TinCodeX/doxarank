---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Support & Sales — DoxaRank" description="Get in touch with the DoxaRank team for inquiries, sales, onboarding, or technical support in Addis Ababa, Ethiopia.">
  <div class="py-20 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200/60 text-emerald-800 text-xs font-semibold uppercase tracking-wider mb-4">
        Support & Sales
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 mb-6">
        We're here to help your search presence grow
      </h1>
      <p class="text-lg text-slate-600">
        Have questions about custom crawls, agency onboarding, or Telebirr payments? Our team is based in Addis Ababa and ready to assist.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
      <!-- Contact Details -->
      <div class="space-y-8 bg-slate-50 border border-slate-200/80 rounded-3xl p-8 sm:p-10">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-slate-900 mb-4">
            Direct Contacts
          </h2>
          <p class="text-sm text-slate-600 leading-relaxed">
            Reach out directly to the right department for fastest response times.
          </p>
        </div>

        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-slate-900">Email Inquiries</h3>
              <p class="text-sm text-slate-600">support@doxarank.com</p>
              <p class="text-xs text-slate-400 mt-0.5">Response within 24 hours</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-slate-900">Location</h3>
              <p class="text-sm text-slate-600">Addis Ababa, Ethiopia</p>
              <p class="text-xs text-slate-400 mt-0.5">East Africa Time (EAT, UTC+3)</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-slate-900">Agency & Enterprise Inquiries</h3>
              <p class="text-sm text-slate-600">sales@doxarank.com</p>
              <p class="text-xs text-slate-400 mt-0.5">For custom reporting and volume keyword tracking</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Inbound Message Form -->
      <div class="bg-white border border-slate-200/80 rounded-3xl p-8 sm:p-10 shadow-sm">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 mb-6">
          Send a Message
        </h2>

        <form class="space-y-4" onsubmit="event.preventDefault(); alert('Thank you for contacting DoxaRank. Our team will get back to you shortly.');">
          <div>
            <label for="name" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Your Name</label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required 
              placeholder="e.g. Abebe Bikila"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500"
            />
          </div>

          <div>
            <label for="email" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Email Address</label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required 
              placeholder="name@company.com"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500"
            />
          </div>

          <div>
            <label for="domain" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Website Domain (Optional)</label>
            <input 
              type="text" 
              id="domain" 
              name="domain" 
              placeholder="e.g. mybusiness.et"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500"
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Message</label>
            <textarea 
              id="message" 
              name="message" 
              rows="4" 
              required 
              placeholder="Tell us how we can help..."
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500"
            ></textarea>
          </div>

          <button 
            type="submit"
            class="w-full py-3.5 px-6 rounded-xl font-semibold text-white bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 transition-colors shadow-md shadow-emerald-600/20 text-sm"
          >
            Send Message
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>
