---
import Layout from '../layouts/Layout.astro';

const featureGroups = [
  {
    id: 'rank-tracker',
    title: 'Ethiopian SERP Rank Tracker',
    tag: 'google.com.et Indexing',
    description: 'Track daily ranking positions accurately on Google Ethiopia. Monitor target keywords in Amharic, Afaan Oromoo, and English.',
    bullets: [
      'Daily position tracking across desktop and mobile devices inside Ethiopia',
      'Fidel normalization for Amharic spelling variations (ሀ/ሃ/ኃ, ሰ/ሠ, አ/ዐ, ጸ/ፀ)',
      'Historical rank movement charts with day-over-day and week-over-week deltas',
      'Target URL mapping and ranking cannibalization alerts',
    ],
  },
  {
    id: 'crawler',
    title: 'Technical SEO Site Crawler',
    tag: 'Automated Auditing',
    description: 'Deep crawl your .et or global domain to detect technical issues before they hurt search visibility.',
    bullets: [
      'Comprehensive checks for HTTP 404s, redirect chains, and server 5xx errors',
      'Title tag, meta description, and heading hierarchy verification (H1-H6)',
      'Canonical URL validation, noindex detection, and robots.txt analysis',
      'XML sitemap validation and indexing status reconciliation',
    ],
  },
  {
    id: 'competitor-snapshots',
    title: 'Competitor SERP Snapshots',
    tag: 'Market Intelligence',
    description: 'Understand who is competing for your commercial keywords on Google Ethiopia and track their movements.',
    bullets: [
      'Head-to-head SERP comparison against up to 5 competitors per project',
      'SERP feature tracking: featured snippets, people also ask, and local packs',
      'Keyword overlap analysis to identify content gaps and ranking opportunities',
      'Competitor URL change tracking over time',
    ],
  },
  {
    id: 'keyword-intelligence',
    title: 'Keyword Intelligence & CPC',
    tag: 'Search Demand',
    description: 'Discover high-intent search queries with localized search demand and advertiser CPC benchmarks.',
    bullets: [
      'Search volume estimates tailored for the Ethiopian digital market',
      'Commercial intent scoring and keyword difficulty indices',
      'Advertiser CPC bid estimates for paid search benchmarking',
      'Related keyword suggestions in English and Amharic script',
    ],
  },
  {
    id: 'recommendations',
    title: 'Actionable Recommendations Feed',
    tag: 'Prioritized Actions',
    description: 'Turn raw SEO data into a prioritized punch-list of technical, content, and link fixes.',
    bullets: [
      'Severity-ranked action items: High, Medium, Low, and Info',
      'Step-by-step resolution guides for web developers and content writers',
      'Dismiss, resolve, and re-audit workflows with change verification',
      'Categorized by on-page SEO, indexability, speed, and metadata',
    ],
  },
  {
    id: 'integrations',
    title: 'Analytics & Search Integrations',
    tag: 'Unified Telemetry',
    description: 'Connect your verified properties seamlessly for unified performance telemetry.',
    bullets: [
      'Google Search Console: Sync queries, impressions, CTR, and average position',
      'Google Analytics 4: Correlate organic search visits with goal conversions',
      'Microsoft Clarity: Link session recordings and heatmaps to organic landing pages',
      'Google Tag Manager: Verify container deployment and conversion trigger tags',
    ],
  },
];
---

<Layout title="Platform Features — DoxaRank | Ethiopia SEO SaaS" description="Explore DoxaRank's complete SEO suite: Google Ethiopia rank tracking, Amharic keyword intelligence, technical site crawler, and analytics integrations.">
  <div class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#f3eef9] border border-[#dac8ee] text-[#774DA9] text-xs font-bold uppercase tracking-wider mb-4">
        <img src="/doxa-logo.png" alt="Doxa" class="h-3.5 w-3.5 object-contain rounded-full" />
        Platform Capabilities
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#24143C] mb-4">
        Purpose-built tools for Ethiopian search optimization
      </h1>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
        Every tool in DoxaRank was designed to solve the real challenges of ranking websites on Google Ethiopia and optimizing Ethiopian digital presence.
      </p>
    </div>

    <!-- Feature Grid (2 Columns, High Information Density) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mb-16">
      {featureGroups.map((feature, idx) => (
        <div id={feature.id} class="bg-white border border-slate-200/90 rounded-2xl p-6 sm:p-7 hover:border-[#774DA9]/60 hover:shadow-lg transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-4 mb-3.5">
              <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-[#f3eef9] text-[#774DA9] border border-[#dac8ee]">
                {feature.tag}
              </span>
              <span class="text-xs font-mono font-bold text-slate-400">
                0{idx + 1}
              </span>
            </div>
            
            <h2 class="text-xl font-bold tracking-tight text-[#24143C] mb-2.5">
              {feature.title}
            </h2>
            
            <p class="text-xs sm:text-sm text-slate-600 mb-5 leading-relaxed">
              {feature.description}
            </p>

            <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700">
              {feature.bullets.map((bullet) => (
                <li class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-[#774DA9] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-6 pt-5 border-t border-slate-100 flex items-center justify-between">
            <span class="text-xs font-medium text-slate-500">Live on Google Ethiopia</span>
            <a href="/signup" class="text-xs font-bold text-[#774DA9] hover:text-[#673f97] flex items-center gap-1 group">
              Try now 
              <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom CTA Card in Doxa Deep Purple -->
    <div class="bg-[#24143C] rounded-2xl p-8 sm:p-12 text-center text-white border border-[#3b1d5f] relative overflow-hidden">
      <div class="absolute -right-10 -bottom-10 w-60 h-60 bg-[#774DA9]/20 blur-[70px] rounded-full pointer-events-none"></div>
      <img src="/doxa-logo.png" alt="Doxa" class="h-10 w-10 mx-auto mb-3 object-contain" />
      <h2 class="text-2xl sm:text-3xl font-extrabold mb-3">
        Ready to audit and rank your website on Google Ethiopia?
      </h2>
      <p class="text-slate-300 max-w-xl mx-auto mb-6 text-sm">
        Join Ethiopian businesses and digital marketing agencies achieving top rankings with DoxaRank.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5">
        <a href="/signup" class="w-full sm:w-auto px-6 py-3 rounded-xl font-bold bg-[#774DA9] hover:bg-[#865cb8] text-white transition-all shadow-md">
          Start Free Account
        </a>
        <a href="/pricing" class="w-full sm:w-auto px-6 py-3 rounded-xl font-semibold bg-[#1a0c2e] hover:bg-[#3b1d5f] text-purple-200 border border-[#3b1d5f] transition-colors">
          View Pricing Plans
        </a>
      </div>
    </div>
  </div>
</Layout>