---
import Layout from '../layouts/Layout.astro';

const plans = [
  {
    id: 'free',
    name: 'Free',
    price: 'ETB 0',
    period: 'forever',
    description: 'Essential rank tracking and health auditing for small websites and personal projects.',
    badge: 'Starter Choice',
    cta: 'Start Free',
    ctaLink: '/signup?plan=free',
    featured: false,
    features: [
      '1 Website project',
      '10 Keywords tracked',
      'Daily Google Ethiopia (google.com.et) updates',
      'Weekly automated technical crawls (up to 250 URLs)',
      'Basic Amharic & English SERP checks',
      'Google Search Console integration',
      'Google Analytics 4 integration',
      'Community email support',
    ],
  },
  {
    id: 'starter',
    name: 'Starter',
    price: 'ETB 1,500',
    period: 'per month',
    description: 'Complete SEO suite for growing Ethiopian businesses, e-commerce, and startups.',
    badge: 'Most Popular',
    cta: 'Get Started with Starter',
    ctaLink: '/signup?plan=starter',
    featured: true,
    features: [
      '5 Website projects',
      '100 Keywords tracked',
      'Daily google.com.et & regional tracking',
      'Amharic Fidel normalization & Oromic intelligence',
      'On-demand technical SEO crawler (up to 2,500 URLs)',
      'Competitor SERP snapshots (up to 5 competitors/project)',
      'Rule-based prioritized recommendation feed',
      'GSC, GA4, Clarity & GTM integrations',
      'Automated email weekly digest',
      'Priority support',
    ],
  },
  {
    id: 'agency',
    name: 'Agency',
    price: 'ETB 6,000',
    period: 'per month',
    description: 'Designed for marketing agencies, large teams, and consultants managing multi-client portfolios.',
    badge: 'Agency Pro',
    cta: 'Get Started with Agency',
    ctaLink: '/signup?plan=agency',
    featured: false,
    features: [
      'Unlimited projects (fair use)',
      '500 Keywords tracked with SERP histories',
      'Deep site audits with custom crawl configurations',
      'White-label executive PDF reports with custom logos',
      'Multi-competitor head-to-head comparisons',
      'Search demand & CPC keyword intelligence',
      'Dedicated integration tokens & multi-user access',
      'Audit log & compliance tracking',
      'Dedicated onboarding & priority SLA',
    ],
  },
];

const faqs = [
  {
    q: 'How does payment work for Ethiopian businesses?',
    a: 'We support local Ethiopian payment methods including Telebirr and local bank transfers via Doxa Payments, alongside international debit/credit cards. Billing is denominated directly in Ethiopian Birr (ETB) with no foreign exchange overhead.',
  },
  {
    q: 'Are there hidden setup fees or long-term contracts?',
    a: 'No. All paid plans are billed on a month-to-month basis. You can upgrade, downgrade, or cancel your subscription at any time without penalties.',
  },
  {
    q: 'Does DoxaRank track Google Ethiopia accurately?',
    a: 'Yes. Our systems query google.com.et with localized IP routing, geolocation parameters, and language headers to deliver true ranking positions as seen by real users in Addis Ababa and regional cities.',
  },
  {
    q: 'What is white-label reporting in the Agency plan?',
    a: 'Agency subscribers can generate branded executive PDF audit and ranking reports featuring their own agency branding, client logos, and custom notes with zero DoxaRank marks.',
  },
];
---

<Layout title="Pricing Plans — DoxaRank | Ethiopia SEO SaaS" description="Transparent pricing for DoxaRank. Free (ETB 0), Starter (ETB 1,500/mo), and Agency (ETB 6,000/mo). Local ETB payments supported.">
  <div class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#f3eef9] border border-[#dac8ee] text-[#774DA9] text-xs font-bold uppercase tracking-wider mb-4">
        <img src="/doxa-logo.png" alt="Doxa" class="h-3.5 w-3.5 object-contain rounded-full" />
        Transparent ETB Pricing
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#24143C] mb-4">
        Simple, predictable plans for every stage of growth
      </h1>
      <p class="text-base sm:text-lg text-slate-600">
        Choose the plan that fits your business. Start free, upgrade anytime, and pay locally in Ethiopian Birr (ETB) with Telebirr or bank transfer.
      </p>
    </div>

    <!-- Pricing Cards (3 Columns) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch mb-20" id="pricing-plans-grid">
      {plans.map((plan) => {
        const isDefault = plan.featured;
        return (
          <div
            data-plan-id={plan.id}
            class={`pricing-card relative rounded-3xl p-6 sm:p-8 flex flex-col justify-between transition-all duration-300 cursor-pointer select-none ${
              isDefault 
                ? 'is-selected bg-gradient-to-b from-[#24143C] to-[#2f194e] text-white shadow-2xl shadow-purple-950/20 ring-2 ring-[#774DA9] md:-translate-y-2' 
                : 'glass-card text-slate-900 border border-purple-200/50 shadow-md hover:border-[#774DA9]/60 hover:shadow-xl'
            }`}
          >
            {plan.badge && (
              <div class={`plan-badge-wrapper absolute -top-3.5 left-1/2 -translate-x-1/2 transition-all duration-200 ${isDefault ? 'opacity-100 scale-100' : 'opacity-0 scale-95 pointer-events-none'}`}>
                <span class="px-4 py-1 rounded-full text-xs font-bold tracking-wide uppercase bg-[#774DA9] text-white shadow-sm border border-purple-400/40">
                  {plan.badge}
                </span>
              </div>
            )}

            <div>
              <div class="flex items-center justify-between mb-3">
                <h3 class="plan-title text-2xl font-bold tracking-tight">{plan.name}</h3>
              </div>
              
              <p class={`plan-desc text-xs sm:text-sm mb-5 leading-relaxed transition-colors ${isDefault ? 'text-purple-200' : 'text-slate-600'}`}>
                {plan.description}
              </p>

              <div class={`plan-divider mb-6 pb-5 border-b transition-colors ${isDefault ? 'border-[#3b1d5f]' : 'border-purple-100'}`}>
                <span class="plan-price text-3xl sm:text-4xl font-extrabold tracking-tight">{plan.price}</span>
                <span class={`plan-period text-xs ml-2 font-medium transition-colors ${isDefault ? 'text-purple-300' : 'text-slate-500'}`}>
                  /{plan.period}
                </span>
              </div>

              <ul class="space-y-3 mb-8 text-xs sm:text-sm">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-2.5">
                    <svg class={`plan-icon w-4 h-4 shrink-0 mt-0.5 transition-colors ${isDefault ? 'text-[#a372df]' : 'text-[#774DA9]'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class={`plan-feature-text transition-colors ${isDefault ? 'text-slate-200' : 'text-slate-700'}`}>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div>
              <a
                href={plan.ctaLink}
                class={`plan-cta w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full font-bold text-sm transition-all ${
                  isDefault
                    ? 'btn-pill-primary shadow-lg'
                    : 'btn-pill-secondary'
                }`}
              >
                <span>{plan.cta}</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- FAQ Section -->
    <div class="max-w-3xl mx-auto border-t border-purple-900/10 pt-14">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#24143C] text-center mb-8">
        Frequently Asked Questions
      </h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="bg-white border border-slate-200/90 rounded-xl p-5 hover:border-[#774DA9]/40 transition">
            <h3 class="text-sm font-bold text-[#24143C] mb-1.5">
              {faq.q}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              {faq.a}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <script>
    function setupPricingInteractivity() {
      const cards = document.querySelectorAll<HTMLElement>('.pricing-card');
      if (!cards.length) return;

      const activeCardClasses = [
        'is-selected',
        'bg-gradient-to-b',
        'from-[#24143C]',
        'to-[#2f194e]',
        'text-white',
        'shadow-2xl',
        'shadow-purple-950/20',
        'ring-2',
        'ring-[#774DA9]',
        'md:-translate-y-2'
      ];

      const inactiveCardClasses = [
        'glass-card',
        'text-slate-900',
        'border',
        'border-purple-200/50',
        'shadow-md',
        'hover:border-[#774DA9]/60',
        'hover:shadow-xl'
      ];

      function selectPlan(targetCard: HTMLElement) {
        cards.forEach((card) => {
          const isSelected = card === targetCard;
          const badgeWrapper = card.querySelector<HTMLElement>('.plan-badge-wrapper');
          const desc = card.querySelector<HTMLElement>('.plan-desc');
          const divider = card.querySelector<HTMLElement>('.plan-divider');
          const period = card.querySelector<HTMLElement>('.plan-period');
          const icons = card.querySelectorAll<HTMLElement>('.plan-icon');
          const featureTexts = card.querySelectorAll<HTMLElement>('.plan-feature-text');
          const cta = card.querySelector<HTMLElement>('.plan-cta');

          if (isSelected) {
            inactiveCardClasses.forEach((cls) => card.classList.remove(cls));
            activeCardClasses.forEach((cls) => card.classList.add(cls));

            if (badgeWrapper) {
              badgeWrapper.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
              badgeWrapper.classList.add('opacity-100', 'scale-100');
            }

            if (desc) {
              desc.classList.remove('text-slate-600');
              desc.classList.add('text-purple-200');
            }

            if (divider) {
              divider.classList.remove('border-purple-100');
              divider.classList.add('border-[#3b1d5f]');
            }

            if (period) {
              period.classList.remove('text-slate-500');
              period.classList.add('text-purple-300');
            }

            icons.forEach((icon) => {
              icon.classList.remove('text-[#774DA9]');
              icon.classList.add('text-[#a372df]');
            });

            featureTexts.forEach((text) => {
              text.classList.remove('text-slate-700');
              text.classList.add('text-slate-200');
            });

            if (cta) {
              cta.classList.remove('btn-pill-secondary');
              cta.classList.add('btn-pill-primary', 'shadow-lg');
            }
          } else {
            activeCardClasses.forEach((cls) => card.classList.remove(cls));
            inactiveCardClasses.forEach((cls) => card.classList.add(cls));

            if (badgeWrapper) {
              badgeWrapper.classList.remove('opacity-100', 'scale-100');
              badgeWrapper.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
            }

            if (desc) {
              desc.classList.remove('text-purple-200');
              desc.classList.add('text-slate-600');
            }

            if (divider) {
              divider.classList.remove('border-[#3b1d5f]');
              divider.classList.add('border-purple-100');
            }

            if (period) {
              period.classList.remove('text-purple-300');
              period.classList.add('text-slate-500');
            }

            icons.forEach((icon) => {
              icon.classList.remove('text-[#a372df]');
              icon.classList.add('text-[#774DA9]');
            });

            featureTexts.forEach((text) => {
              text.classList.remove('text-slate-200');
              text.classList.add('text-slate-700');
            });

            if (cta) {
              cta.classList.remove('btn-pill-primary', 'shadow-lg');
              cta.classList.add('btn-pill-secondary');
            }
          }
        });
      }

      cards.forEach((card) => {
        card.addEventListener('click', (e) => {
          selectPlan(card);
        });
      });

      // Check query parameter if present
      const params = new URLSearchParams(window.location.search);
      const planQuery = params.get('plan');
      if (planQuery) {
        const matchingCard = document.querySelector<HTMLElement>(`[data-plan-id="${planQuery.toLowerCase()}"]`);
        if (matchingCard) {
          selectPlan(matchingCard);
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupPricingInteractivity);
    } else {
      setupPricingInteractivity();
    }
    document.addEventListener('astro:page-load', setupPricingInteractivity);
  </script>
</Layout>