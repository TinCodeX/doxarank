                        <td class="py-2.5 px-3 text-slate-400">0</td>
                        <td class="py-2.5 px-3">850</td>
                        <td class="py-2.5 px-3 text-slate-300">$0.28</td>
                        <td class="py-2.5 px-3 font-sans"><span class="rounded bg-emerald-500/10 px-1.5 py-0.5 text-[10px] text-emerald-300 border border-emerald-500/20">Transactional</span></td>
