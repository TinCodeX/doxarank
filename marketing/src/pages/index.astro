---
import Layout from '../layouts/Layout.astro';
import { Globe, Languages, Server, BarChart3, Check, TrendingUp, Lightbulb, Sparkles, ArrowRight, ShieldCheck, Zap } from 'lucide-astro';

const differentiators = [
  {
    key: 'diff.et_engine',
    iconComponent: Globe,
    title: 'Google Ethiopia SERP Engine',
    subtitle: 'google.com.et Indexing',
    description: 'Track desktop and mobile ranking positions as seen by searchers inside Ethiopia, not foreign approximations.',
  },
  {
    key: 'diff.nlp',
    iconComponent: Languages,
    title: 'Amharic & Oromic Search NLP',
    subtitle: 'Multilingual Fidel Engine',
    description: 'Unicode preservation and Fidel homophone handling (ሀ/ሐ/ኀ, ሰ/ሠ, አ/ዐ) so queries like ሆቴል match accurately.',
  },
  {
    key: 'diff.domain',
    iconComponent: Server,
    title: '.et Domain Architecture',
    subtitle: '.com.et · .org.et · .edu.et',
    description: 'Purpose-built crawling diagnostics tailored for Ethiopian organizational and commercial web infrastructure.',
  },
  {
    key: 'diff.volume',
    iconComponent: BarChart3,
    title: 'Search Volume & CPC Demand',
    subtitle: 'Volume & Intent Benchmarks',
    description: 'Access localized monthly search queries, advertiser CPC benchmarks, and intent classification for Ethiopian queries.',
  },
];

const coreFeatures = [
  {
    key: 'feat.rank_tracker',
    badge: 'SERP Monitoring',
    title: 'Daily Rank Tracker',
    description: 'Monitor daily search positions on Google Ethiopia (google.com.et) across desktop and mobile devices with movement alerts.',
    icon: 'M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z',
    link: '/features#rank-tracker',
  },
  {
    key: 'feat.crawler',
    badge: 'Site Health',
    title: 'Technical SEO Crawler',
    description: 'Audit your website for broken links, redirect chains, slow response times, missing title tags, and meta descriptions.',
    icon: 'M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-.778.099-1.533.284-2.253',
    link: '/features#crawler',
  },
  {
    key: 'feat.keyword',
    badge: 'Search Economics',
    title: 'Keyword Intelligence & CPC',
    description: 'Understand monthly query volume, advertiser CPC bid ranges, competition index, and deterministic search intent in Ethiopia.',
    icon: 'M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
    link: '/features#keyword-intelligence',
  },
  {
    key: 'feat.competitor',
    badge: 'Market Share',
    title: 'Competitor SERP Snapshots',
    description: 'Capture point-in-time SERP rankings for your target queries and benchmark your visibility directly against local rivals.',
    icon: 'M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z',
    link: '/features#competitor-snapshots',
  },
  {
    key: 'feat.recommendations',
    badge: 'Prioritized Action',
    title: 'SEO Recommendations Feed',
    description: 'Actionable audit insights prioritized by severity and business impact across technical, content, and ranking opportunities.',
    icon: 'M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z',
    link: '/features#recommendations',
  },
  {
    key: 'feat.integrations',
    badge: 'Ecosystem',
    title: 'Native Analytics Integrations',
    description: 'Connect Google Search Console, Google Analytics 4, Microsoft Clarity, and GTM in one click via secure OAuth2.',
    icon: 'M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244',
    link: '/features#integrations',
  },
  {
    key: 'feat.reports',
    badge: 'Client Deliverables',
    title: 'Agency White-Label Reports',
    description: 'Compile executive PDF reports branded with your client’s identity, custom title, and zero vendor marks.',
    icon: 'M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z',
    link: '/features#reports',
  },
  {
    key: 'feat.tools',
    badge: 'Public Utilities',
    title: 'Free Standalone SEO Tools',
    description: 'Meta tag generator, robots.txt validator, Amharic normalizer, HTTP status code checker, and redirect path analyzer.',
    icon: 'M11.42 15.17L17.25 21A2.67 2.67 0 0021 17.25l-5.87-5.83m-3.71 3.75a3.75 3.75 0 01-5.3-5.3l5.3-5.3a3.75 3.75 0 015.3 5.3l-1.59 1.59',
    link: '/features#tools',
  },
];
---

<Layout
  title="DoxaRank — The Ethiopia-First SEO Platform"
  description="SEO platform built for Ethiopia. Track rankings on Google Ethiopia (google.com.et), analyze Amharic and Oromo keywords, audit technical SEO on .et domains, and benchmark competitors."
>
  
  <!-- ========================================================================= -->
  <!-- 1. HERO SECTION (Dreamy Fly.io Mesh Gradient & Editorial Elegance) -->
  <!-- ========================================================================= -->
  <section class="relative overflow-hidden pt-8 pb-12 sm:pt-14 sm:pb-18">
    
    <!-- Ambient Dreamy Color Blooms (Peach, Lavender, Sky-Blue) -->
    <div class="absolute top-0 left-1/4 -translate-x-1/2 w-[520px] h-[380px] bg-rose-200/40 rounded-full blur-[110px] pointer-events-none -z-10"></div>
    <div class="absolute top-10 right-1/4 translate-x-1/2 w-[560px] h-[420px] bg-purple-200/50 rounded-full blur-[120px] pointer-events-none -z-10"></div>
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[700px] h-[340px] bg-indigo-100/60 rounded-full blur-[130px] pointer-events-none -z-10"></div>

    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 relative z-10">
      
      <div class="mx-auto max-w-3xl text-center">
        
        <!-- Floating Pill Badge -->
        <div class="inline-flex items-center gap-2 rounded-full glass-pill px-4 py-1.5 text-xs font-semibold text-[#24143C] shadow-xs mb-6 sm:mb-8 transition hover:border-purple-300">
          <img src="/doxa-logo.png" alt="Doxa" class="h-4 w-4 object-contain rounded-full" />
          <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span data-i18n="hero.badge">Built for Google Ethiopia (google.com.et) &amp; .et Web Properties</span>
        </div>

        <!-- Main Headline (Editorial Fly.io Style Display Serif) -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-[#24143C] leading-[1.08] sm:leading-[1.08]">
          <span data-i18n="hero.title_part1">Scale Full Stack SEO</span> <br />
          <span class="font-serif-display italic font-normal text-[#582e8e] selection:text-white" data-i18n="hero.title_part2">
            Without the Blindspots
          </span>
        </h1>

        <!-- High-Impact Subtitle -->
        <p class="mt-6 text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto" data-i18n="hero.subtitle">
          <strong class="text-[#24143C] font-semibold">Over 350,000 queries</strong> indexed on DoxaRank, boosted by real-time Google Ethiopia (google.com.et) tracking, multilingual Amharic &amp; Oromo NLP, .et domain crawler audits, and live CPC benchmarks.
        </p>

        <!-- Pill CTA Action Buttons -->
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
          <a
            href="/signup"
            class="btn-pill-primary w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 text-sm sm:text-base font-semibold group shadow-md"
          >
            <span data-i18n="hero.cta_start">Speedrun Your Rankings</span>
            <svg class="h-4 w-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
            </svg>
          </a>
          <a
            href="/features"
            class="btn-pill-secondary w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 text-sm sm:text-base font-semibold"
          >
            <span data-i18n="hero.cta_features">Explore Platform Features</span>
          </a>
        </div>

        <p class="mt-3.5 text-xs text-slate-500 font-medium" data-i18n="hero.subtext">
          Free forever tier available · No credit card required · Instant setup in under 2 minutes
        </p>

        <!-- Ecosystem Pill Badges -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs text-slate-600">
          <span class="glass-pill rounded-full px-3 py-1 font-medium flex items-center gap-1.5 text-slate-700">
            <Check class="w-3.5 h-3.5 text-[#774DA9]" /> Google Search Console
          </span>
          <span class="glass-pill rounded-full px-3 py-1 font-medium flex items-center gap-1.5 text-slate-700">
            <Check class="w-3.5 h-3.5 text-[#774DA9]" /> Google Analytics 4
          </span>
          <span class="glass-pill rounded-full px-3 py-1 font-medium flex items-center gap-1.5 text-slate-700">
            <Check class="w-3.5 h-3.5 text-[#774DA9]" /> Microsoft Clarity
          </span>
          <span class="glass-pill rounded-full px-3 py-1 font-medium flex items-center gap-1.5 text-emerald-700 bg-emerald-50/70 border-emerald-200">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span> google.com.et SERP
          </span>
        </div>

      </div>

      <!-- ========================================================================= -->
      <!-- LIVE ETHIOPIAN KEYWORD & SERP INSPECTOR (Interactive Capsule) -->
      <!-- ========================================================================= -->
      <div class="mt-12 sm:mt-16 mx-auto max-w-4xl">
        <div class="glass-card rounded-3xl p-5 sm:p-7 shadow-lg border border-purple-200/60 bg-white/90">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-5 border-b border-purple-100">
            <div>
              <div class="flex items-center gap-2">
                <span class="rounded-full bg-purple-100 px-2.5 py-0.5 text-[10px] font-bold text-[#774DA9] uppercase tracking-wide">
                  Live SERP Simulation
                </span>
                <span class="text-xs text-slate-500 font-medium">google.com.et index</span>
              </div>
              <h3 class="text-lg font-extrabold text-[#24143C] mt-1">Explore High-Intent Ethiopian Search Queries</h3>
            </div>
            
            <!-- Filter Pills -->
            <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0" id="query-filter-tabs">
              <button
                type="button"
                data-filter="all"
                class="filter-pill active rounded-full px-3 py-1 text-xs font-semibold bg-[#774DA9] text-white shadow-xs cursor-pointer transition"
              >
                All Languages
              </button>
              <button
                type="button"
                data-filter="am"
                class="filter-pill rounded-full px-3 py-1 text-xs font-semibold bg-white text-slate-700 hover:bg-purple-50 hover:text-[#774DA9] border border-purple-200/60 cursor-pointer transition"
              >
                🇪🇹 Amharic
              </button>
              <button
                type="button"
                data-filter="om"
                class="filter-pill rounded-full px-3 py-1 text-xs font-semibold bg-white text-slate-700 hover:bg-purple-50 hover:text-[#774DA9] border border-purple-200/60 cursor-pointer transition"
              >
                🇪🇹 Afaan Oromoo
              </button>
              <button
                type="button"
                data-filter="en"
                class="filter-pill rounded-full px-3 py-1 text-xs font-semibold bg-white text-slate-700 hover:bg-purple-50 hover:text-[#774DA9] border border-purple-200/60 cursor-pointer transition"
              >
                🌍 English
              </button>
            </div>
          </div>

          <!-- Query Table in Glass Container -->
          <div class="overflow-x-auto mt-4">
            <table class="w-full text-left text-xs sm:text-sm" id="serp-query-table">
              <thead>
                <tr class="text-[11px] font-bold uppercase tracking-wider text-slate-400 border-b border-purple-100">
                  <th class="py-2.5 px-3">Keyword Query</th>
                  <th class="py-2.5 px-3">Position</th>
                  <th class="py-2.5 px-3">Monthly Volume</th>
                  <th class="py-2.5 px-3">Est. CPC (ETB)</th>
                  <th class="py-2.5 px-3">Intent</th>
                  <th class="py-2.5 px-3 text-right">SERP Snippet</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-purple-50 font-medium text-slate-700" id="query-table-body">
                <tr data-lang="am" class="hover:bg-purple-50/50 transition">
                  <td class="py-3 px-3 font-semibold text-[#24143C] flex items-center gap-2">
                    <span class="rounded-full bg-purple-100 text-[#774DA9] text-[10px] px-1.5 py-0.5 font-bold">AM</span>
                    የአዲስ አበባ ሆቴል
                  </td>
                  <td class="py-3 px-3 font-bold text-emerald-600">
                    <span class="rounded-full bg-emerald-50 px-2 py-0.5 border border-emerald-200 text-xs">#3 (+2)</span>
                  </td>
                  <td class="py-3 px-3 font-mono">2,400 /mo</td>
                  <td class="py-3 px-3 font-mono text-slate-600">42 ETB</td>
                  <td class="py-3 px-3">
                    <span class="rounded-full bg-amber-50 text-amber-700 border border-amber-200 px-2 py-0.5 text-[11px] font-bold">Commercial</span>
                  </td>
                  <td class="py-3 px-3 text-right">
                    <span class="text-xs text-[#774DA9] font-semibold hover:underline cursor-pointer">Local Pack (Map)</span>
                  </td>
                </tr>

                <tr data-lang="en" class="hover:bg-purple-50/50 transition">
                  <td class="py-3 px-3 font-semibold text-[#24143C] flex items-center gap-2">
                    <span class="rounded-full bg-indigo-100 text-indigo-700 text-[10px] px-1.5 py-0.5 font-bold">EN</span>
                    best hotels in addis ababa
                  </td>
                  <td class="py-3 px-3 font-bold text-emerald-600">
                    <span class="rounded-full bg-emerald-50 px-2 py-0.5 border border-emerald-200 text-xs">#2 (+1)</span>
                  </td>
                  <td class="py-3 px-3 font-mono">5,400 /mo</td>
                  <td class="py-3 px-3 font-mono text-slate-600">105 ETB</td>
                  <td class="py-3 px-3">
                    <span class="rounded-full bg-amber-50 text-amber-700 border border-amber-200 px-2 py-0.5 text-[11px] font-bold">Commercial</span>
                  </td>
                  <td class="py-3 px-3 text-right">
                    <span class="text-xs text-[#774DA9] font-semibold hover:underline cursor-pointer">Sitelinks Snippet</span>
                  </td>
                </tr>

                <tr data-lang="om" class="hover:bg-purple-50/50 transition">
                  <td class="py-3 px-3 font-semibold text-[#24143C] flex items-center gap-2">
                    <span class="rounded-full bg-emerald-100 text-emerald-700 text-[10px] px-1.5 py-0.5 font-bold">OM</span>
                    buna oromiyaa gatii
                  </td>
                  <td class="py-3 px-3 font-bold text-emerald-600">
                    <span class="rounded-full bg-emerald-50 px-2 py-0.5 border border-emerald-200 text-xs">#1 (0)</span>
                  </td>
                  <td class="py-3 px-3 font-mono">1,850 /mo</td>
                  <td class="py-3 px-3 font-mono text-slate-600">35 ETB</td>
                  <td class="py-3 px-3">
                    <span class="rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 px-2 py-0.5 text-[11px] font-bold">Transactional</span>
                  </td>
                  <td class="py-3 px-3 text-right">
                    <span class="text-xs text-[#774DA9] font-semibold hover:underline cursor-pointer">Product Grid</span>
                  </td>
                </tr>

                <tr data-lang="am" class="hover:bg-purple-50/50 transition">
                  <td class="py-3 px-3 font-semibold text-[#24143C] flex items-center gap-2">
                    <span class="rounded-full bg-purple-100 text-[#774DA9] text-[10px] px-1.5 py-0.5 font-bold">AM</span>
                    ቡና መግዛት ኦንላይን
                  </td>
                  <td class="py-3 px-3 font-bold text-emerald-600">
                    <span class="rounded-full bg-emerald-50 px-2 py-0.5 border border-emerald-200 text-xs">#2 (+3)</span>
                  </td>
                  <td class="py-3 px-3 font-mono">1,120 /mo</td>
                  <td class="py-3 px-3 font-mono text-slate-600">38 ETB</td>
                  <td class="py-3 px-3">
                    <span class="rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 px-2 py-0.5 text-[11px] font-bold">Transactional</span>
                  </td>
                  <td class="py-3 px-3 text-right">
                    <span class="text-xs text-[#774DA9] font-semibold hover:underline cursor-pointer">Organic #2</span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="mt-4 pt-3 border-t border-purple-100 flex flex-col sm:flex-row sm:items-center justify-between text-xs text-slate-500 gap-2">
            <span class="flex items-center gap-1.5">
              <ShieldCheck class="w-4 h-4 text-emerald-500" />
              Verified with live Google Ethiopia SERP telemetry.
            </span>
            <a href="/features#keyword-intelligence" class="font-bold text-[#774DA9] hover:text-[#673f97] inline-flex items-center gap-1">
              Explore Keyword Demand Explorer <ArrowRight class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 2. WHY LOCAL CONTEXT MATTERS (Soft Rounded Cards & Pastel Glow) -->
  <!-- ========================================================================= -->
  <section class="py-16 sm:py-20 relative">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      
      <div class="mx-auto max-w-2xl text-center">
        <span class="glass-pill rounded-full px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[#774DA9]">
          The Ethiopia Advantage
        </span>
        <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-[#24143C] sm:text-4xl" data-i18n="diff.heading">
          Why Ethiopian Brands Choose DoxaRank
        </h2>
        <p class="mt-3 text-sm sm:text-base text-slate-600" data-i18n="diff.subheading">
          International SEO tools overlook google.com.et nuances, fidel homophones, and .et hosting realities. We built from the ground up for Ethiopia.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {differentiators.map((item) => {
          const IconComp = item.iconComponent;
          return (
            <div class="glass-card glass-card-hover rounded-3xl p-6 flex flex-col justify-between">
              <div>
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-[#f3eef9] to-purple-100 text-[#774DA9] shadow-2xs">
                  <IconComp class="w-6 h-6" />
                </div>
                <h3 class="mt-4 text-base font-bold text-[#24143C]" data-i18n={`${item.key}.title`}>{item.title}</h3>
                <p class="text-[11px] font-bold text-[#774DA9] uppercase tracking-wider mt-0.5" data-i18n={`${item.key}.subtitle`}>{item.subtitle}</p>
                <p class="mt-2.5 text-xs text-slate-600 leading-relaxed" data-i18n={`${item.key}.desc`}>{item.description}</p>
              </div>
              <div class="mt-4 pt-3 border-t border-purple-100/60 text-[11px] font-semibold text-[#774DA9]">
                Ethiopian Market Native
              </div>
            </div>
          );
        })}
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
