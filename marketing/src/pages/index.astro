                    <span class="text-xl sm:text-2xl font-extrabold text-white">48</span>
                    <span class="text-xs text-slate-400">/ 50 limit</span>
                  </div>
                  <div class="text-[10px] text-slate-500 mt-0.5">English, Amharic, Oromo</div>
                </div>

                <div class="rounded-lg bg-slate-950 p-3.5 border border-slate-800">
                  <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Technical Health</div>
                  <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-xl sm:text-2xl font-extrabold text-emerald-400">92/100</span>
                    <span class="text-xs text-slate-400">0 critical</span>
                  </div>
