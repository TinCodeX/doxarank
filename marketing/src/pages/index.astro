                  <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Search Demand</div>
                  <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-xl sm:text-2xl font-extrabold text-indigo-400">42.5K</span>
                    <span class="text-xs text-slate-400">/month</span>
                  </div>
                  <div class="text-[10px] text-slate-500 mt-0.5">Ethiopia search impressions</div>
                </div>
              </div>

              <!-- Tracked Keywords SERP Table Preview -->
              <div class="mt-4 rounded-lg bg-slate-950 border border-slate-800 overflow-hidden">
                <div class="border-b border-slate-800 px-4 py-2.5 flex items-center justify-between text-xs">
