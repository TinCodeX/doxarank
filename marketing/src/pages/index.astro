                        <th class="py-2.5 px-3">Intent</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-850 font-mono text-slate-200">
                      <tr>
                        <td class="py-2.5 px-4 font-sans font-semibold text-white">የአዲስ አበባ ሆቴል</td>
                        <td class="py-2.5 px-3 text-emerald-400 font-bold">#3</td>
                        <td class="py-2.5 px-3 text-emerald-400">▲ +2</td>
                        <td class="py-2.5 px-3">2,400</td>
                        <td class="py-2.5 px-3 text-slate-300">$0.35</td>
