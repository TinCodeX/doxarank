---

<Layout
  title="DoxaRank — The Ethiopia-First SEO Platform"
  description="SEO platform built for Ethiopia. Track rankings on Google Ethiopia (google.com.et), analyze Amharic and Oromo keywords, audit technical SEO on .et domains, and benchmark competitors."
>
  
  <!-- ========================================================================= -->
  <!-- 1. HERO SECTION -->
  <!-- ========================================================================= -->
  <section class="relative overflow-hidden bg-white pt-16 pb-20 lg:pt-24 lg:pb-28">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(45rem_50rem_at_top,theme(colors.indigo.50),white)] opacity-60"></div>
    
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        
        <!-- Ethiopia-First Pill Badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-indigo-200/80 bg-indigo-50/80 px-3.5 py-1 text-xs font-semibold text-indigo-900 shadow-xs mb-8">
          <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Built for Google Ethiopia (google.com.et) &amp; .et Domains</span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-6xl lg:text-7xl">
          SEO built for <br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-indigo-600 to-blue-600 bg-clip-text text-transparent">Ethiopia.</span>
        </h1>

        <!-- Supporting Subtitle -->
        <p class="mt-6 text-lg sm:text-xl text-slate-600 leading-relaxed max-w-2xl mx-auto">
          Track rankings on Google Ethiopia, analyze Amharic and Oromo search demand, audit technical SEO on .et websites, and benchmark competitors — unified with native Google and Microsoft analytics.
        </p>

        <!-- CTA Action Buttons -->
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/signup"
            class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl bg-indigo-600 px-6 py-3.5 text-base font-semibold text-white shadow-md hover:bg-indigo-700 transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
          >
            Start Free
            <svg class="ml-2 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
            </svg>
          </a>
          <a
            href="#features"
            class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-6 py-3.5 text-base font-semibold text-slate-700 shadow-xs hover:bg-slate-50 transition"
          >
            Explore Features
          </a>
        </div>

        <!-- Trust / Safety Note -->
        <p class="mt-4 text-xs text-slate-500 font-medium">
          Free tier available · No credit card required · Instant setup in minutes
        </p>

        <!-- Platform Integration Logos Bar -->
        <div class="mt-14 border-t border-slate-100 pt-8">
          <p class="text-xs font-semibold tracking-wider text-slate-400 uppercase">
            Native integrations with leading search &amp; analytics tools
          </p>
          <div class="mt-5 flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-slate-600 text-xs font-bold">
            <span class="flex items-center gap-1.5"><span class="text-blue-600 text-sm">✦</span> Google Search Console</span>
            <span class="flex items-center gap-1.5"><span class="text-amber-500 text-sm">✦</span> Google Analytics 4</span>
            <span class="flex items-center gap-1.5"><span class="text-cyan-600 text-sm">✦</span> Microsoft Clarity</span>
            <span class="flex items-center gap-1.5"><span class="text-indigo-600 text-sm">✦</span> Google Tag Manager</span>
            <span class="flex items-center gap-1.5"><span class="text-emerald-600 text-sm">✦</span> google.com.et SERP</span>
          </div>
        </div>

      </div>

      <!-- ========================================================================= -->
      <!-- 2. PRODUCT VISUAL (Illustrative Dashboard Preview) -->
