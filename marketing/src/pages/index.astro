<script>
  // Tab filtering for Live SERP simulation
  const tabs = document.querySelectorAll('#query-filter-tabs .filter-pill');
  const rows = document.querySelectorAll('#query-table-body tr');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => {
        t.classList.remove('active', 'bg-[#774DA9]', 'text-white', 'shadow-xs');
        t.classList.add('bg-white', 'text-slate-700', 'border', 'border-purple-200/60');
      });

      tab.classList.add('active', 'bg-[#774DA9]', 'text-white', 'shadow-xs');
      tab.classList.remove('bg-white', 'text-slate-700', 'border-purple-200/60');

      const filter = tab.getAttribute('data-filter');
      rows.forEach(row => {
        const rowLang = row.getAttribute('data-lang');
        if (filter === 'all' || rowLang === filter) {
          (row as HTMLElement).style.display = '';
        } else {
          (row as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>