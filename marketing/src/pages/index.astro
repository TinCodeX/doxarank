---
import Layout from '../layouts/Layout.astro';
import { Globe, Languages, Server, BarChart3, Check, TrendingUp, Lightbulb } from 'lucide-astro';

const differentiators = [
  {
    key: 'diff.et_engine',
    iconComponent: Globe,
    title: 'Google Ethiopia SERP Engine',
    subtitle: 'google.com.et Indexing',
    description: 'Track desktop and mobile ranking positions as seen by searchers inside Ethiopia, not foreign approximations.',
  },
  {
    key: 'diff.nlp',
    iconComponent: Languages,
    title: 'Amharic & Oromo Search NLP',
    subtitle: 'Multilingual Fidel Engine',
    description: 'Unicode preservation and Fidel homophone handling (ሀ/ሐ/ኀ, ሰ/ሠ, አ/ዐ) so queries like ሆቴል match accurately.',
  },
  {
    key: 'diff.domain',
    iconComponent: Server,
    title: '.et Domain Architecture',
    subtitle: '.com.et · .org.et · .edu.et',
    description: 'Purpose-built crawling diagnostics tailored for Ethiopian organizational and commercial web infrastructure.',
  },
  {
    key: 'diff.volume',
    iconComponent: BarChart3,
    title: 'Search Volume & CPC Demand',
    subtitle: 'Volume & Intent Benchmarks',
    description: 'Access localized monthly search queries, advertiser CPC benchmarks, and intent classification for Ethiopian queries.',
  },
];

const coreFeatures = [
  {
    key: 'feat.rank_tracker',
    badge: 'SERP Monitoring',
    title: 'Daily Rank Tracker',
    description: 'Monitor daily search positions on Google Ethiopia (google.com.et) across desktop and mobile devices with movement alerts.',
    icon: 'M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z',
    link: '/features#rank-tracker',
  },
  {
    key: 'feat.crawler',
    badge: 'Site Health',
    title: 'Technical SEO Crawler',
    description: 'Audit your website for broken links, redirect chains, slow response times, missing title tags, and meta descriptions.',
    icon: 'M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-.778.099-1.533.284-2.253',
    link: '/features#crawler',
  },
  {
    key: 'feat.keyword',
    badge: 'Search Economics',
    title: 'Keyword Intelligence & CPC',
    description: 'Understand monthly query volume, advertiser CPC bid ranges, competition index, and deterministic search intent in Ethiopia.',
    icon: 'M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
    link: '/features#keyword-intelligence',
  },
  {
    key: 'feat.competitor',
    badge: 'Market Share',
    title: 'Competitor SERP Snapshots',
    description: 'Capture point-in-time SERP rankings for your target queries and benchmark your visibility directly against local rivals.',
    icon: 'M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z',
    link: '/features#competitor-snapshots',
  },
  {
    key: 'feat.recommendations',
    badge: 'Prioritized Action',
    title: 'SEO Recommendations Feed',
    description: 'Actionable audit insights prioritized by severity and business impact across technical, content, and ranking opportunities.',
    icon: 'M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z',
    link: '/features#recommendations',
  },
  {
    key: 'feat.integrations',
    badge: 'Ecosystem',
    title: 'Native Analytics Integrations',
    description: 'Connect Google Search Console, Google Analytics 4, Microsoft Clarity, and GTM in one click via secure OAuth2.',
    icon: 'M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244',
    link: '/features#integrations',
  },
  {
    key: 'feat.reports',
    badge: 'Client Deliverables',
    title: 'Agency White-Label Reports',
    description: 'Compile executive PDF reports branded with your client’s identity, custom title, and zero vendor marks.',
    icon: 'M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z',
    link: '/features#reports',
  },
  {
    key: 'feat.tools',
    badge: 'Public Utilities',
    title: 'Free Standalone SEO Tools',
    description: 'Meta tag generator, robots.txt validator, Amharic normalizer, HTTP status code checker, and redirect path analyzer.',
    icon: 'M11.42 15.17L17.25 21A2.67 2.67 0 0021 17.25l-5.87-5.83m-3.71 3.75a3.75 3.75 0 01-5.3-5.3l5.3-5.3a3.75 3.75 0 015.3 5.3l-1.59 1.59',
    link: '/features#tools',
  },
];
---

<Layout
  title="DoxaRank — The Ethiopia-First SEO Platform"
  description="SEO platform built for Ethiopia. Track rankings on Google Ethiopia (google.com.et), analyze Amharic and Oromo keywords, audit technical SEO on .et domains, and benchmark competitors."
>
  
  <!-- ========================================================================= -->
  <!-- 1. HERO SECTION (Doxa Deep Purple Accents & High Information Density) -->
  <!-- ========================================================================= -->
  <section class="relative overflow-hidden bg-white pt-12 pb-16 sm:pt-16 sm:pb-20 border-b border-purple-900/10">
    <!-- Subtle Ambient Brand Glow -->
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-[#774DA9]/10 blur-[100px] pointer-events-none rounded-full"></div>
    
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative">
      <div class="mx-auto max-w-3xl text-center">
        
        <!-- Official Brand Logo & Ethiopia Badge -->
        <div class="inline-flex items-center gap-2.5 rounded-full border border-[#e3d7f1] bg-[#f8f5fc] px-4 py-1.5 text-xs font-semibold text-[#24143C] shadow-xs mb-6">
          <img src="/doxa-logo.png" alt="Doxa" class="h-4 w-4 object-contain rounded-full" />
          <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span data-i18n="hero.badge">Built for Google Ethiopia (google.com.et) &amp; .et Web Properties</span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-4xl font-extrabold tracking-tight text-[#24143C] sm:text-5xl lg:text-6xl leading-tight">
          <span data-i18n="hero.title_part1">SEO engineered for</span> <br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-[#24143C] via-[#774DA9] to-[#9d6cd3] bg-clip-text text-transparent" data-i18n="hero.title_part2">the Ethiopian Market.</span>
        </h1>

        <!-- Supporting Subtitle -->
        <p class="mt-5 text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto" data-i18n="hero.subtitle">
          Track Google Ethiopia SERPs, uncover high-intent Amharic and English search queries, audit .et technical architecture, and unify search data with Google and Microsoft Clarity.
        </p>

        <!-- CTA Action Buttons -->
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3.5">
          <a
            href="/signup"
            class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl bg-[#774DA9] px-6 py-3.5 text-sm font-bold text-white shadow-md hover:bg-[#673f97] hover:shadow-lg transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#774DA9]"
          >
            <span data-i18n="hero.cta_start">Start Free on Google Ethiopia</span>
            <svg class="ml-2 h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
            </svg>
          </a>
          <a
            href="/features"
            class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-6 py-3.5 text-sm font-semibold text-slate-700 shadow-xs hover:bg-[#faf7fd] hover:text-[#774DA9] transition-all"
          >
            <span data-i18n="hero.cta_features">Explore Platform Features</span>
          </a>
        </div>

        <p class="mt-3.5 text-xs text-slate-500 font-medium" data-i18n="hero.subtext">
          Free tier available · No credit card required · Instant setup in under 2 minutes
        </p>

        <!-- Platform Ecosystem Badges -->
        <div class="mt-10 border-t border-slate-100 pt-6">
          <p class="text-[11px] font-bold tracking-wider text-slate-400 uppercase" data-i18n="hero.integrations_title">
            Unified integrations with essential search &amp; analytics tools
          </p>
          <div class="mt-3 flex flex-wrap items-center justify-center gap-5 sm:gap-8 text-slate-600 text-xs font-semibold">
            <span class="flex items-center gap-1.5"><Check class="w-3.5 h-3.5 text-[#774DA9]" /> Google Search Console</span>
            <span class="flex items-center gap-1.5"><Check class="w-3.5 h-3.5 text-[#774DA9]" /> Google Analytics 4</span>
            <span class="flex items-center gap-1.5"><Check class="w-3.5 h-3.5 text-[#774DA9]" /> Microsoft Clarity</span>
            <span class="flex items-center gap-1.5"><Check class="w-3.5 h-3.5 text-[#774DA9]" /> Google Tag Manager</span>
            <span class="flex items-center gap-1.5 text-emerald-700 font-bold"><Check class="w-3.5 h-3.5 text-emerald-500" /> google.com.et SERP</span>
          </div>
        </div>

      </div>

      <!-- ========================================================================= -->
      <!-- 2. PRODUCT DASHBOARD PREVIEW (Professional Doxa Shell) -->
      <!-- ========================================================================= -->
      <div class="mt-10 sm:mt-12 relative">
        <div class="mx-auto max-w-5xl rounded-2xl border border-purple-900/15 bg-white p-2.5 sm:p-3 shadow-2xl shadow-purple-950/10">
          
          <!-- Mock Browser Window Frame in Deep Doxa Color -->
          <div class="rounded-xl border border-[#3b1d5f] bg-[#24143C] overflow-hidden text-slate-200">
            
            <!-- Window Header Bar -->
            <div class="flex items-center justify-between border-b border-[#3b1d5f] bg-[#1a0c2e] px-4 py-2.5 text-xs">
              <div class="flex items-center gap-2">
                <span class="h-2.5 w-2.5 rounded-full bg-rose-500"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-amber-500"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
                <span class="ml-2 font-mono text-purple-300/80 hidden sm:inline">app.doxarank.com/dashboard</span>
              </div>
              <div class="flex items-center gap-2 font-semibold">
                <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="text-emerald-400 text-xs">Target: Google Ethiopia (google.com.et)</span>
              </div>
            </div>

            <!-- Dashboard Content Preview -->
            <div class="bg-[#24143C] p-4 sm:p-6 text-slate-100">
              
              <!-- Dashboard Top Bar -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#3b1d5f] pb-4">
                <div class="flex items-center gap-3">
                  <img src="/doxa-logo.png" alt="Doxa" class="h-8 w-8 object-contain rounded-md" />
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-bold uppercase tracking-wider text-[#a372df]">Active Project</span>
                      <span class="rounded bg-[#3b1d5f] px-2 py-0.5 text-[10px] font-bold text-purple-200 border border-purple-700/60">
                        https://addishotels.et
                      </span>
                    </div>
                    <h2 class="text-base sm:text-lg font-bold text-white mt-0.5">Addis Hospitality Group</h2>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <span class="rounded-md bg-emerald-950 px-2.5 py-1 text-xs font-semibold text-emerald-300 border border-emerald-800">
                    ● SERP Tracker Active
                  </span>
                  <span class="rounded-md bg-[#3b1d5f] px-2.5 py-1 text-xs text-purple-200 border border-purple-700/60">
                    Desktop + Mobile
                  </span>
                </div>
              </div>

              <!-- 4 Stat Summary Cards -->
              <div class="mt-4 grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
                <div class="rounded-lg bg-[#1b0d2f] p-3.5 border border-[#3b1d5f]">
                  <div class="text-[11px] font-semibold text-purple-300 uppercase tracking-wider">Visibility Index</div>
                  <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-xl sm:text-2xl font-extrabold text-white">78.2%</span>
                    <span class="text-xs font-bold text-emerald-400 flex items-center gap-0.5"><TrendingUp class="w-3 h-3" /> +5.2%</span>
                  </div>
                  <div class="text-[10px] text-slate-400 mt-0.5">Top 100 on google.com.et</div>
                </div>

                <div class="rounded-lg bg-[#1b0d2f] p-3.5 border border-[#3b1d5f]">
                  <div class="text-[11px] font-semibold text-purple-300 uppercase tracking-wider">Tracked Keywords</div>
                  <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-xl sm:text-2xl font-extrabold text-white">48</span>
                    <span class="text-xs text-slate-400">/ 50 limit</span>
                  </div>
                  <div class="text-[10px] text-slate-400 mt-0.5">Amharic &amp; English queries</div>
                </div>

                <div class="rounded-lg bg-[#1b0d2f] p-3.5 border border-[#3b1d5f]">
                  <div class="text-[11px] font-semibold text-purple-300 uppercase tracking-wider">Technical Health</div>
                  <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-xl sm:text-2xl font-extrabold text-emerald-400">94/100</span>
                    <span class="text-xs text-slate-400">0 critical</span>
                  </div>
                  <div class="text-[10px] text-slate-400 mt-0.5">180 URLs audited</div>
                </div>

                <div class="rounded-lg bg-[#1b0d2f] p-3.5 border border-[#3b1d5f]">
                  <div class="text-[11px] font-semibold text-purple-300 uppercase tracking-wider">Search Demand</div>
                  <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-xl sm:text-2xl font-extrabold text-[#a372df]">42.5K</span>
                    <span class="text-xs text-slate-400">/month</span>
                  </div>
                  <div class="text-[10px] text-slate-400 mt-0.5">Ethiopia impressions</div>
                </div>
              </div>

              <!-- Tracked Keywords SERP Table Preview -->
              <div class="mt-4 rounded-lg bg-[#1b0d2f] border border-[#3b1d5f] overflow-hidden">
                <div class="border-b border-[#3b1d5f] px-4 py-2.5 flex items-center justify-between text-xs">
                  <span class="font-bold text-white">Target Keywords (google.com.et)</span>
                  <span class="text-purple-300 hidden sm:inline">Last check: Live EAT</span>
                </div>
                <div class="overflow-x-auto">
                  <table class="w-full text-left text-xs">
                    <thead>
                      <tr class="border-b border-[#3b1d5f] text-slate-400 font-semibold bg-[#160b24]">
                        <th class="py-2.5 px-4">Keyword Query</th>
                        <th class="py-2.5 px-3">Position</th>
                        <th class="py-2.5 px-3">Change</th>
                        <th class="py-2.5 px-3">Volume</th>
                        <th class="py-2.5 px-3">Est. CPC</th>
                        <th class="py-2.5 px-3">Intent</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-[#2a1545] font-mono text-slate-200">
                      <tr>
                        <td class="py-2.5 px-4 font-sans font-semibold text-white">የአዲስ አበባ ሆቴል</td>
                        <td class="py-2.5 px-3 text-emerald-400 font-bold">#3</td>
                        <td class="py-2.5 px-3 text-emerald-400 font-semibold"><span class="inline-flex items-center gap-0.5"><TrendingUp class="w-3 h-3" /> +2</span></td>
                        <td class="py-2.5 px-3">2,400</td>
                        <td class="py-2.5 px-3 text-slate-300">$0.35</td>
                        <td class="py-2.5 px-3 font-sans"><span class="rounded bg-amber-500/20 px-1.5 py-0.5 text-[10px] text-amber-300 border border-amber-500/30">Commercial</span></td>
                      </tr>
                      <tr>
                        <td class="py-2.5 px-4 font-sans font-semibold text-white">best hotels in addis ababa</td>
                        <td class="py-2.5 px-3 text-purple-300 font-bold">#7</td>
                        <td class="py-2.5 px-3 text-emerald-400 font-semibold"><span class="inline-flex items-center gap-0.5"><TrendingUp class="w-3 h-3" /> +1</span></td>
                        <td class="py-2.5 px-3">5,400</td>
                        <td class="py-2.5 px-3 text-slate-300">$0.85</td>
                        <td class="py-2.5 px-3 font-sans"><span class="rounded bg-amber-500/20 px-1.5 py-0.5 text-[10px] text-amber-300 border border-amber-500/30">Commercial</span></td>
                      </tr>
                      <tr>
                        <td class="py-2.5 px-4 font-sans font-semibold text-white">ቡና መግዛት</td>
                        <td class="py-2.5 px-3 text-emerald-400 font-bold">#2</td>
                        <td class="py-2.5 px-3 text-slate-400">0</td>
                        <td class="py-2.5 px-3">850</td>
                        <td class="py-2.5 px-3 text-slate-300">$0.28</td>
                        <td class="py-2.5 px-3 font-sans"><span class="rounded bg-emerald-500/20 px-1.5 py-0.5 text-[10px] text-emerald-300 border border-emerald-500/30">Transactional</span></td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>

              <!-- Active Recommendation Pill -->
              <div class="mt-4 rounded-lg bg-[#3b1d5f]/70 border border-[#774DA9]/60 p-3 flex items-start gap-2.5 text-xs text-purple-200">
                <Lightbulb class="w-4 h-4 text-amber-400 shrink-0 mt-0.5" />
                <div>
                  <strong class="text-white">Active Recommendation:</strong> Resolve 3 redirect chains on <code class="text-[#a372df]">/destinations</code> to conserve crawl budget and accelerate SERP indexation.
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 3. ETHIOPIA-FIRST ADVANTAGE (Compact 4-Card Grid) -->
  <!-- ========================================================================= -->
  <section class="border-b border-purple-900/10 bg-[#faf9fc] py-14 sm:py-18">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-xs font-bold uppercase tracking-wider text-[#774DA9]">Why Local Context Matters</h2>
        <p class="mt-2 text-2xl font-extrabold tracking-tight text-[#24143C] sm:text-3xl" data-i18n="diff.heading">
          Why Ethiopian Brands &amp; Agencies Choose DoxaRank
        </p>
        <p class="mt-3 text-sm text-slate-600" data-i18n="diff.subheading">
          International SEO tools overlook google.com.et nuances, fidel homophones, and .et hosting realities. We built from the ground up for Ethiopia.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {differentiators.map((item) => {
          const IconComp = item.iconComponent;
          return (
            <div class="rounded-xl border border-purple-900/10 bg-white p-5 shadow-xs hover:border-[#774DA9]/50 hover:shadow-md transition">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-[#f3eef9] text-[#774DA9]">
                <IconComp class="w-5 h-5" />
              </div>
              <h3 class="mt-3 text-base font-bold text-[#24143C]" data-i18n={`${item.key}.title`}>{item.title}</h3>
              <p class="text-[11px] font-semibold text-[#774DA9] uppercase tracking-wide" data-i18n={`${item.key}.subtitle`}>{item.subtitle}</p>
              <p class="mt-2 text-xs text-slate-600 leading-relaxed" data-i18n={`${item.key}.desc`}>{item.description}</p>
            </div>
          );
        })}
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 4. CORE FEATURES (Organized Feature Grid) -->
  <!-- ========================================================================= -->
  <section id="features" class="bg-white py-14 sm:py-20 border-b border-purple-900/10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-xs font-bold uppercase tracking-wider text-[#774DA9]">Comprehensive Platform</h2>
        <p class="mt-2 text-2xl font-extrabold tracking-tight text-[#24143C] sm:text-3xl" data-i18n="feat.heading">
          Engineered specifically for Ethiopian search market realities
        </p>
        <p class="mt-3 text-sm text-slate-600" data-i18n="feat.subheading">
          Everything your team needs to optimize, track, and dominate search visibility on google.com.et.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {coreFeatures.map((feat) => (
          <div class="group relative rounded-xl border border-slate-200/90 p-5 bg-white hover:border-[#774DA9]/60 hover:shadow-md transition flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between">
                <span class="rounded bg-[#f3eef9] px-2 py-0.5 text-[10px] font-bold text-[#774DA9] uppercase tracking-wider" data-i18n={`${feat.key}.badge`}>
                  {feat.badge}
                </span>
                <div class="h-8 w-8 rounded-lg bg-[#f3eef9] text-[#774DA9] flex items-center justify-center">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d={feat.icon} />
                  </svg>
                </div>
              </div>
              <h3 class="mt-3 text-sm font-bold text-[#24143C] group-hover:text-[#774DA9] transition" data-i18n={`${feat.key}.title`}>
                {feat.title}
              </h3>
              <p class="mt-1.5 text-xs text-slate-600 leading-relaxed" data-i18n={`${feat.key}.desc`}>
                {feat.description}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100">
              <a href={feat.link} class="inline-flex items-center text-xs font-bold text-[#774DA9] hover:text-[#673f97]">
                Explore capability
                <svg class="ml-1 h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 5. FINAL HIGH-IMPACT CALL TO ACTION -->
  <!-- ========================================================================= -->
  <section class="bg-[#24143C] text-white py-16 sm:py-20 relative overflow-hidden">
    <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-[#774DA9]/20 blur-[90px] rounded-full pointer-events-none"></div>
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <img src="/doxa-logo.png" alt="Doxa" class="h-12 w-12 mx-auto mb-4 object-contain" />
      <h2 class="text-3xl font-extrabold sm:text-4xl tracking-tight" data-i18n="cta.title">
        Ready to accelerate your search visibility in Ethiopia?
      </h2>
      <p class="mt-4 text-base text-slate-300 max-w-xl mx-auto" data-i18n="cta.subtitle">
        Join leading Ethiopian brands and agencies already tracking their organic Google performance with DoxaRank.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/signup"
          data-i18n="cta.start"
          class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl bg-[#774DA9] px-7 py-3.5 text-sm font-bold text-white shadow-lg hover:bg-[#865cb8] transition"
        >
          Start Free 14-Day Trial
        </a>
        <a
          href="/pricing"
          class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl border border-[#3b1d5f] bg-[#1a0c2e] px-7 py-3.5 text-sm font-semibold text-purple-200 hover:bg-[#3b1d5f] transition"
        >
          Compare Pricing Plans
        </a>
      </div>
      <p class="mt-4 text-xs text-slate-400">
        Free forever tier available · Instant setup · Built for Ethiopian domains
      </p>
    </div>
  </section>

</Layout>