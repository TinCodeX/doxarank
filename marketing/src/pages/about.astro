---
import Layout from '../layouts/Layout.astro';
import { Zap, Globe, ShieldCheck } from 'lucide-astro';
---

<Layout title="About Us — DoxaRank | Ethiopia SEO SaaS" description="Learn about DoxaRank's mission to empower Ethiopian businesses, developers, and marketing agencies with world-class, localized SEO software.">
  <div class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#f3eef9] border border-[#dac8ee] text-[#774DA9] text-xs font-bold uppercase tracking-wider mb-4">
        <img src="/doxa-logo.png" alt="Doxa" class="h-3.5 w-3.5 object-contain rounded-full" />
        Our Purpose &amp; Mission
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#24143C] mb-4">
        Building the SEO infrastructure for Ethiopia's digital economy
      </h1>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
        Global SEO platforms overlook Ethiopian search dynamics. DoxaRank was engineered to provide accurate, localized search intelligence for businesses operating in Ethiopia.
      </p>
    </div>

    <!-- Story / Context -->
    <div class="space-y-8 text-slate-700 leading-relaxed mb-16">
      <div class="bg-white border border-slate-200/90 rounded-2xl p-6 sm:p-8 shadow-xs space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#24143C]">
          The Problem with Traditional SEO Tools in Ethiopia
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          For years, digital marketers, software engineers, and business leaders across Addis Ababa and Ethiopia were forced to rely on foreign platforms that introduced major hurdles:
        </p>
        <ul class="space-y-3 pl-4 border-l-2 border-[#774DA9] text-xs sm:text-sm text-slate-700">
          <li><strong>No Google Ethiopia accuracy:</strong> Foreign crawlers polled from distant US/European datacenters, yielding search ranks that diverged sharply from what users inside Ethiopia see on <code class="text-[#774DA9] font-mono bg-[#f3eef9] px-1.5 py-0.5 rounded">google.com.et</code>.</li>
          <li><strong>Zero Amharic language support:</strong> Keyword research engines failed to handle Ethiopic Fidel scripts or common orthographic variations (such as homophone normalization between ሀ, ሐ, and ኀ).</li>
          <li><strong>Foreign exchange friction:</strong> Foreign platforms demanded USD credit cards, imposing artificial limits on local Ethiopian startups and marketing consultancies.</li>
        </ul>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white border border-purple-900/10 rounded-2xl p-6 shadow-xs">
          <div class="w-8 h-8 rounded-lg bg-[#f3eef9] text-[#774DA9] flex items-center justify-center font-bold text-xs mb-3">
            01
          </div>
          <h3 class="text-base font-bold text-[#24143C] mb-1.5">Localized Engineering</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            DoxaRank integrates local IP routing for verifiable Google Ethiopia position tracking, Amharic Fidel normalization, and automated crawling optimized for <code class="text-[#774DA9] font-mono bg-[#f3eef9] px-1 rounded">.et</code> web properties.
          </p>
        </div>

        <div class="bg-white border border-purple-900/10 rounded-2xl p-6 shadow-xs">
          <div class="w-8 h-8 rounded-lg bg-[#f3eef9] text-[#774DA9] flex items-center justify-center font-bold text-xs mb-3">
            02
          </div>
          <h3 class="text-base font-bold text-[#24143C] mb-1.5">Local Currency Billing (ETB)</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Through Doxa Payments, subscriptions are transparently billed in Ethiopian Birr (ETB), supporting Telebirr and local bank transfers so you never encounter forex limits.
          </p>
        </div>
      </div>
    </div>

    <!-- Operating Principles -->
    <div class="border-t border-purple-900/10 pt-12">
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#24143C] text-center mb-8">
        Our Operating Principles
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 text-center">
        <div class="p-5 rounded-xl bg-white border border-slate-200/90 shadow-xs flex flex-col items-center">
          <div class="w-10 h-10 rounded-lg bg-[#f5f0fa] flex items-center justify-center text-[#774DA9] mb-3">
            <Zap class="w-5 h-5" />
          </div>
          <h3 class="font-bold text-sm text-[#24143C] mb-1.5">Technical Rigor</h3>
          <p class="text-xs text-slate-600">We prioritize actionable, rule-based auditing data and verifiable SERP positions over vanity metrics.</p>
        </div>
        <div class="p-5 rounded-xl bg-white border border-slate-200/90 shadow-xs flex flex-col items-center">
          <div class="w-10 h-10 rounded-lg bg-[#f5f0fa] flex items-center justify-center text-[#774DA9] mb-3">
            <Globe class="w-5 h-5" />
          </div>
          <h3 class="font-bold text-sm text-[#24143C] mb-1.5">Ethiopian Context</h3>
          <p class="text-xs text-slate-600">From language normalization to local payment integrations, every feature is tailored for Ethiopian search reality.</p>
        </div>
        <div class="p-5 rounded-xl bg-white border border-slate-200/90 shadow-xs flex flex-col items-center">
          <div class="w-10 h-10 rounded-lg bg-[#f5f0fa] flex items-center justify-center text-[#774DA9] mb-3">
            <ShieldCheck class="w-5 h-5" />
          </div>
          <h3 class="font-bold text-sm text-[#24143C] mb-1.5">Data Privacy</h3>
          <p class="text-xs text-slate-600">Read-only integrations for Google Search Console and GA4 with secure OAuth protocols and audit trails.</p>
        </div>
      </div>
    </div>
  </div>
</Layout>
