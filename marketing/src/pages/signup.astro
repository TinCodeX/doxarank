---
import Layout from '../layouts/Layout.astro';

const dashboardUrl = import.meta.env.PUBLIC_DASHBOARD_URL || 'http://localhost:5173';
---

<Layout title="Start Free — DoxaRank | Ethiopia SEO SaaS" description="Create your free DoxaRank account. Track google.com.et rankings, run technical crawls, and optimize for Ethiopian search.">
  <section class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 relative">
    <div class="w-full max-w-md glass-card rounded-3xl shadow-xl p-8 text-center border border-purple-200/60 bg-white/90">
      <img
        src="/doxa-logo.png"
        alt="DoxaRank Logo"
        class="h-14 w-14 object-contain mx-auto mb-3 rounded-full shadow-xs"
        width="56"
        height="56"
      />

      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-[#f3eef9] border border-purple-200 text-[#774DA9] text-xs font-bold mb-3">
        Free Tier &bull; ETB 0 / forever
      </div>

      <h1 class="text-2xl font-extrabold tracking-tight text-[#24143C] mb-1.5">
        Get Started with DoxaRank
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 mb-6">
        Start tracking Google Ethiopia keywords, run automated technical audits, and connect your analytics. No credit card required.
      </p>

      <div class="space-y-3.5">
        <a 
          href={`${dashboardUrl}/register`}
          class="btn-pill-primary w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-bold text-white shadow-md"
        >
          <span>Create Account on Dashboard</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <div class="relative py-2">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-purple-100"></div>
          </div>
          <div class="relative flex justify-center text-xs uppercase">
            <span class="bg-white/90 px-3 text-slate-400 font-semibold rounded-full">Already registered?</span>
          </div>
        </div>

        <a 
          href="/login" 
          class="btn-pill-secondary w-full inline-flex items-center justify-center px-6 py-3 text-xs sm:text-sm font-semibold text-slate-700"
        >
          Sign In to Existing Account
        </a>
      </div>

      <div class="mt-6 pt-5 border-t border-purple-100 text-xs text-slate-600 text-left space-y-2">
        <p class="font-bold text-[#24143C]">Included in Free Tier:</p>
        <ul class="space-y-1.5 text-slate-600 text-[11px] sm:text-xs">
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-[#774DA9] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            1 Tracked Project
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-[#774DA9] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            10 Tracked Keywords on google.com.et
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-[#774DA9] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            Weekly Technical Health Crawl
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-[#774DA9] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            Google Search Console &amp; GA4 Integration
          </li>
        </ul>
      </div>
    </div>
  </section>
</Layout>
