---
import Layout from '../../layouts/Layout.astro';

const articles = [
  {
    title: 'How Google Ethiopia (google.com.et) Differs from Global Search',
    date: 'September 2026',
    category: 'Local Search',
    excerpt: 'An in-depth look at localized SERP features, geo-targeting signals, and why IP routing determines true search visibility in Ethiopia.',
    readTime: '6 min read',
  },
  {
    title: 'Amharic Fidel Normalization: Overcoming Ethiopic Orthographic Variations in SEO',
    date: 'August 2026',
    category: 'Keyword Intelligence',
    excerpt: 'Why search engines struggle with homophones like ሀ/ሐ/ኀ and how to normalize keyword clusters to capture high-intent Ethiopian queries.',
    readTime: '8 min read',
  },
  {
    title: 'Technical SEO Checklist for .et and Ethiopian Commercial Websites',
    date: 'August 2026',
    category: 'Technical Auditing',
    excerpt: 'Key crawling pitfalls, international targeting tags, canonical structures, and DNS latency considerations for Ethiopian domains.',
    readTime: '7 min read',
  },
];
---

<Layout title="SEO Insights & Resources — DoxaRank Blog" description="Actionable guides, search intelligence insights, and technical advice for ranking websites on Google Ethiopia.">
  <div class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#f3eef9] border border-[#dac8ee] text-[#774DA9] text-xs font-bold uppercase tracking-wider mb-4">
        <img src="/doxa-logo.png" alt="Doxa" class="h-3.5 w-3.5 object-contain rounded-full" />
        Search Engineering Blog
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#24143C] mb-3">
        Ethiopia SEO Insights &amp; Research
      </h1>
      <p class="text-base text-slate-600">
        Practical research, technical guides, and SERP analysis curated by search practitioners in Addis Ababa.
      </p>
    </div>

    <!-- Articles List -->
    <div class="space-y-6 mb-16">
      {articles.map((post) => (
        <article class="bg-white border border-slate-200/90 rounded-2xl p-6 sm:p-7 hover:border-[#774DA9]/60 hover:shadow-md transition">
          <div class="flex items-center gap-3 text-xs text-slate-500 mb-2.5">
            <span class="px-2.5 py-0.5 rounded-full bg-[#f3eef9] text-[#774DA9] font-bold border border-[#dac8ee]">
              {post.category}
            </span>
            <span>&bull;</span>
            <span>{post.date}</span>
            <span>&bull;</span>
            <span>{post.readTime}</span>
          </div>

          <h2 class="text-xl font-bold tracking-tight text-[#24143C] mb-2 hover:text-[#774DA9] transition-colors cursor-pointer">
            {post.title}
          </h2>

          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
            {post.excerpt}
          </p>

          <a href="/signup" class="inline-flex items-center text-xs font-bold text-[#774DA9] hover:text-[#673f97]">
            Read full technical guide &rarr;
          </a>
        </article>
      ))}
    </div>
  </div>
</Layout>
