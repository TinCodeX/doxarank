---
import Layout from '../layouts/Layout.astro';

const dashboardUrl = import.meta.env.PUBLIC_DASHBOARD_URL || 'http://localhost:5173';
---

<Layout title="Sign In — DoxaRank | Ethiopia SEO SaaS" description="Sign in to your DoxaRank account to access your Ethiopia SEO analytics, rank tracking, and site audits.">
  <section class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 relative">
    <div class="w-full max-w-md glass-card rounded-3xl shadow-xl p-8 text-center border border-purple-200/60 bg-white/90">
      <img
        src="/doxa-logo.png"
        alt="DoxaRank Logo"
        class="h-14 w-14 object-contain mx-auto mb-4 rounded-full shadow-xs"
        width="56"
        height="56"
      />

      <h1 class="text-2xl font-extrabold tracking-tight text-[#24143C] mb-1.5">
        Welcome to DoxaRank
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 mb-6">
        Sign in to access your Ethiopian SERP rank tracker, technical audits, and analytics integrations.
      </p>

      <div class="space-y-3.5">
        <a 
          href={`${dashboardUrl}/login`}
          class="btn-pill-primary w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-bold text-white shadow-md"
        >
          <span>Continue to Dashboard Login</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <div class="relative py-2">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-purple-100"></div>
          </div>
          <div class="relative flex justify-center text-xs uppercase">
            <span class="bg-white/90 px-3 text-slate-400 font-semibold rounded-full">New to DoxaRank?</span>
          </div>
        </div>

        <a 
          href="/signup" 
          class="btn-pill-secondary w-full inline-flex items-center justify-center px-6 py-3 text-xs sm:text-sm font-semibold text-slate-700"
        >
          Create a Free Account
        </a>
      </div>

      <div class="mt-6 pt-5 border-t border-purple-100 text-[11px] text-slate-500">
        <p>Connecting to DoxaRank Dashboard at <code class="text-[#774DA9] font-mono">{dashboardUrl}</code></p>
      </div>
    </div>
  </section>
</Layout>
