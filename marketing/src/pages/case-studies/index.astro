---
import Layout from '../../layouts/Layout.astro';

const caseStudies = [
  {
    title: 'Financial Services & Banking in Ethiopia: Optimizing Local Intent Queries',
    sector: 'Banking & FinTech',
    overview: 'An illustrative technical framework exploring how financial institutions structure crawl hierarchies and monitor high-intent queries around forex exchange rates, mobile money, and digital banking on google.com.et.',
    focusAreas: ['Bilingual Keyword Intent', 'Local SERP Snippets', 'Site Speed & Core Web Vitals'],
    status: 'Sector Framework',
  },
  {
    title: 'Multi-Category E-Commerce: Indexation Architecture for Large Product Catalogs',
    sector: 'Retail & E-Commerce',
    overview: 'An example architectural guide for managing crawl budgets and preventing duplicate content across dynamic category and filtering pages on Ethiopian .et domains.',
    focusAreas: ['Faceted Navigation Auditing', 'Canonical URL Consistency', 'Internal Link Architecture'],
    status: 'Architecture Blueprint',
  },
  {
    title: 'Digital Media & News Outlets: Real-Time Amharic Search Indexing',
    sector: 'Media & Publishing',
    overview: 'A hypothetical implementation blueprint for high-frequency publishing workflows using automated XML sitemaps and Amharic Fidel normalization for breaking news discovery.',
    focusAreas: ['Google News Inclusion', 'Amharic Headline Optimization', 'Server Response Latency'],
    status: 'Publishing Guide',
  },
];
---

<Layout title="Industry Frameworks & Use Cases — DoxaRank" description="Technical frameworks and SEO workflows for Google Ethiopia across banking, e-commerce, and media publishing.">
  <div class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#f3eef9] border border-[#dac8ee] text-[#774DA9] text-xs font-bold uppercase tracking-wider mb-4">
        <img src="/doxa-logo.png" alt="Doxa" class="h-3.5 w-3.5 object-contain rounded-full" />
        Industry Frameworks &amp; Workflows
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#24143C] mb-3">
        Search Optimization in Practice
      </h1>
      <p class="text-base text-slate-600">
        These illustrative frameworks demonstrate how DoxaRank's technical crawling, SERP intelligence, and language normalization apply to key Ethiopian industries.
      </p>
    </div>

    <!-- Framework Note -->
    <div class="mb-10 bg-[#faf7fd] border border-purple-900/10 rounded-2xl p-5 text-xs sm:text-sm text-slate-600 flex items-start gap-3.5">
      <div class="w-6 h-6 rounded-full bg-[#f3eef9] text-[#774DA9] flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
        i
      </div>
      <div>
        <p class="font-bold text-[#24143C] mb-1">Framework Note</p>
        <p class="leading-relaxed">
          The examples below are presented as illustrative technical use cases and architecture guides for Ethiopian web platforms. They outline recommended technical practices and do not represent measured historical outcomes, third-party client testimonials, or commercial performance metrics.
        </p>
      </div>
    </div>

    <!-- Case Studies / Frameworks Grid -->
    <div class="space-y-6 mb-16">
      {caseStudies.map((study) => (
        <div class="bg-white border border-slate-200/90 rounded-2xl p-6 sm:p-7 hover:border-[#774DA9]/60 hover:shadow-md transition">
          <div class="flex items-center justify-between gap-4 mb-2.5">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-[#f3eef9] text-[#774DA9] border border-[#dac8ee]">
              {study.sector}
            </span>
            <span class="text-xs font-mono font-bold text-slate-400">
              {study.status}
            </span>
          </div>

          <h2 class="text-lg sm:text-xl font-bold tracking-tight text-[#24143C] mb-2">
            {study.title}
          </h2>

          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
            {study.overview}
          </p>

          <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center gap-2">
            <span class="text-xs font-bold text-slate-500 mr-2">Focus Areas:</span>
            {study.focusAreas.map((area) => (
              <span class="text-[11px] bg-slate-100 text-slate-700 px-2.5 py-1 rounded-md font-medium">
                {area}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
