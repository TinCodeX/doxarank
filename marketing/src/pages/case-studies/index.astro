---
import Layout from '../../layouts/Layout.astro';

const caseStudies = [
  {
    title: 'Financial Services & Banking in Ethiopia: Optimizing Local Intent Queries',
    sector: 'Banking & FinTech',
    overview: 'An illustrative technical framework exploring how financial institutions structure crawl hierarchies and monitor high-intent queries around forex exchange rates, mobile money, and digital banking on google.com.et.',
    focusAreas: ['Bilingual Keyword Intent', 'Local SERP Snippets', 'Site Speed & Core Web Vitals'],
    status: 'Hypothetical Workflow',
  },
  {
    title: 'Multi-Category E-Commerce: Indexation Architecture for Large Product Catalogs',
    sector: 'Retail & E-Commerce',
    overview: 'An example architectural guide for managing crawl budgets and preventing duplicate content across dynamic category and filtering pages on Ethiopian .et domains.',
    focusAreas: ['Faceted Navigation Auditing', 'Canonical URL Consistency', 'Internal Link Architecture'],
    status: 'Illustrative Architecture',
  },
  {
    title: 'Digital Media & News Outlets: Real-Time Amharic Search Indexing',
    sector: 'Media & Publishing',
    overview: 'A hypothetical implementation blueprint for high-frequency publishing workflows using automated XML sitemaps and Amharic Fidel normalization for breaking news discovery.',
    focusAreas: ['Google News Inclusion', 'Amharic Headline Optimization', 'Server Response Latency'],
    status: 'Example Framework',
  },
];
---

<Layout title="Illustrative Frameworks & Use Cases — DoxaRank" description="Illustrative technical frameworks and hypothetical SEO workflows for Google Ethiopia across banking, e-commerce, and media publishing.">
  <div class="py-20 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200/60 text-emerald-800 text-xs font-semibold uppercase tracking-wider mb-4">
        Illustrative Frameworks &amp; Workflows
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 mb-6">
        Search Optimization in Practice
      </h1>
      <p class="text-lg text-slate-600">
        These illustrative frameworks demonstrate how DoxaRank's technical crawling, SERP intelligence, and language normalization apply to key Ethiopian industries.
      </p>
    </div>

    <!-- Methodology Disclaimer Callout -->
    <div class="mb-12 bg-slate-50 border border-slate-200 rounded-2xl p-6 text-sm text-slate-600 flex items-start gap-4">
      <div class="w-6 h-6 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
        i
      </div>
      <div>
        <p class="font-semibold text-slate-800 mb-1">Framework Note</p>
        <p>
          The examples below are presented as illustrative technical use cases and hypothetical architecture guides for Ethiopian web platforms. They outline recommended technical practices and do not represent measured historical outcomes, third-party client testimonials, or commercial performance metrics.
        </p>
      </div>
    </div>

    <!-- Case Studies / Frameworks Grid -->
    <div class="space-y-8 mb-16">
      {caseStudies.map((study) => (
        <div class="bg-white border border-slate-200/80 rounded-3xl p-8 hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between gap-4 mb-4">
            <span class="px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200/60">
              {study.sector}
            </span>
            <span class="text-xs font-medium text-slate-500 bg-slate-100 px-3 py-1 rounded-full border border-slate-200/60">
              {study.status}
            </span>
          </div>

          <h2 class="text-2xl font-bold tracking-tight text-slate-900 mb-3">
            {study.title}
          </h2>

          <p class="text-slate-600 text-sm leading-relaxed mb-6">
            {study.overview}
          </p>

          <div class="border-t border-slate-100 pt-4">
            <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3">Core Technical Focus</h3>
            <div class="flex flex-wrap gap-2">
              {study.focusAreas.map((tag) => (
                <span class="px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 text-slate-700">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="bg-slate-900 text-white rounded-3xl p-10 text-center">
      <h3 class="text-2xl font-bold mb-3">Have a complex technical SEO deployment?</h3>
      <p class="text-slate-300 text-sm max-w-xl mx-auto mb-6">
        Talk with our team in Addis Ababa to configure custom crawl parameters, large-scale keyword monitoring, or agency reporting.
      </p>
      <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 rounded-xl font-semibold bg-emerald-500 hover:bg-emerald-400 text-slate-950 transition-colors text-sm">
        Contact Our Team
      </a>
    </div>
  </div>
</Layout>
