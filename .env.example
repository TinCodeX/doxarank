# ==============================================================================
# DoxaRank Monorepo — Unified Environment Configuration Guide
# ==============================================================================
# DoxaRank uses a SERVICE-ISOLATED environment structure for security and build stability:
#
# 1. `backend/.env`   -> Private server settings, database credentials, AI/payment keys.
# 2. `dashboard/.env` -> Client-side Vite configuration (public `VITE_` variables).
# 3. `marketing/.env` -> Public marketing site configuration (Astro `PUBLIC_` variables).
#
# For Docker Compose / Dokploy orchestration from the repository root, you can optionally
# copy this file to `.env` in the root, or allow Compose to load per-service env files.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Service (Django / Daphne / Celery) — backend/.env
# ------------------------------------------------------------------------------
SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-random-key
DEBUG=True
DOXARANK_ENV=development
DATABASE_URL=postgres://postgres:postgres@db:5432/doxarank
ALLOWED_HOSTS=127.0.0.1,localhost,testserver,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4321,http://127.0.0.1:4321
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4321,http://127.0.0.1:4321

# Token Encryption Key (Fernet 32-byte base64)
DOXARANK_ENCRYPTION_KEY=

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# LLM & AI Providers
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

# SEO Intelligence (DataForSEO)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_API_URL=https://api.dataforseo.com/v3
KEYWORD_INTELLIGENCE_PROVIDER=unconfigured

# Google Cloud OAuth & Search Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback/

# Microsoft Clarity
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/clarity/callback/
CLARITY_API_BASE_URL=https://www.clarity.ms/api/v1

# Doxa Payments (Chapa / Telebirr)
DOXA_PAYMENTS_API_KEY=
DOXA_PAYMENTS_SECRET=
DOXA_PAYMENTS_BASE_URL=https://api.doxapayments.com/v1
DOXA_PAYMENTS_WEBHOOK_SECRET=

# Crawler & SERP Defaults
CRAWLER_USER_AGENT=DoxaRankBot/1.0 (+https://doxarank.com/bot)
CRAWLER_REQUEST_TIMEOUT=15
CRAWLER_MAX_CONCURRENT_REQUESTS=5
SERP_REQUEST_DELAY=1.5
SERP_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 2. Frontend Dashboard Service (Vite / React) — dashboard/.env
# ------------------------------------------------------------------------------
VITE_API_URL=http://127.0.0.1:8000
VITE_CLARITY_PROJECT_ID=

# ------------------------------------------------------------------------------
# 3. Marketing Landing Site (Astro) — marketing/.env
# ------------------------------------------------------------------------------
PUBLIC_DASHBOARD_URL=http://localhost:5173
PUBLIC_API_URL=http://127.0.0.1:8000
